class SimpleClass {
    public static staticValue: int = 100;
    public value: int;

    constructor(value: int) {
        this.value = value;
    }

    public getValue(): int {
        return this.value;
    }

    public incrementValue() {
        this.value = this.value + 1;
    }

    public getTuple(): { int, () => int, bool } {
        return { 1, () => 2, false };
    }
}

class ComplexClass {
    public age: int;
    public name: string;
    public hairColor: string;

    constructor(age: int, name: string, hairColor: string) {
        this.age = age;
        this.name = name;
        this.hairColor = hairColor;
    }

    constructor(age: int) {
        this.age = age;
        this.name = "Joe";
        this.hairColor = "Black";
    }

    public getAge(): int {
        return this.age;
    }

    public getName(): string {
        return this.name;
    }

    public getHairColor(): string {
        return this.hairColor;
    }

    public static create(): ComplexClass {
        return new ComplexClass(2);
    }
}

class CircularReferenceClassA {
    private b: CircularReferenceClassB;

    constructor(otherB: CircularReferenceClassB) {
        this.b = otherB;
    }

    public getB(): CircularReferenceClassB {
        return this.b;
    }
}

class CircularReferenceClassB {
    private a: CircularReferenceClassA;

    constructor(otherA: CircularReferenceClassA) {
        this.a = otherA;
    }

    public getA(): CircularReferenceClassA {
        return this.a;
    }
}

enum SimpleEnum {
    Alpha,
    Beta,
    Gamma
}

enum StringEnum {
    Alpha = "alpha",
    Beta = "beta",
    Gamma = "gamma"
}

func getInt(x: int): int {
    return x;
}

func getFloat(y: float): float {
    return y;
}

func getBool(x: bool): bool {
    return x;
}

func getChar(y: char): char {
    return y;
}

func getString(x: string): string {
    return x;
}

func getArray(y: [int]): [int] {
    return y;
}

func getRefArray(y: [int]): ref<[int]> {
    return ref y;
}

func testPassUpInt(): ref<int> {
    const x = 121;
    return ref x;
}

func testDoublePassUpInt(): ref<int> {
    return testPassUpInt();
}

func testPassUpIntAlt(): ref<int> {
    const x = ref 121;
    return x;
}

func testDoublePassUpIntAlt(): ref<int> {
    return testPassUpIntAlt();
}

proc testPassInIntRef(x: ref<int>, refCount: int) {
    assertDebugRefCount(x, refCount);
}

proc testArcPassUp() {
    assertDebugRefCount(testPassUpIntAlt(), 1);
    testPassInIntRef(testPassUpIntAlt(), 2);
    const passedUpXAlt = testPassUpIntAlt();
    assertDebugRefCount(passedUpXAlt, 1);
    testPassInIntRef(passedUpXAlt, 2);

    assertDebugRefCount(testDoublePassUpIntAlt(), 1);
    testPassInIntRef(testDoublePassUpIntAlt(), 2);
    const doublePassedUpXAlt = testDoublePassUpIntAlt();
    assertDebugRefCount(doublePassedUpXAlt, 1);
    testPassInIntRef(doublePassedUpXAlt, 2);

    assertDebugRefCount(testPassUpInt(), 1);
    testPassInIntRef(testPassUpInt(), 2);
    const passedUpX = testPassUpInt();
    assertDebugRefCount(passedUpX, 1);
    testPassInIntRef(passedUpX, 2);
    const anotherX = passedUpX;
    assertDebugRefCount(passedUpX, 2);
    testPassInIntRef(passedUpX, 3);
    testPassInIntRef(anotherX, 3);
    assert(passedUpX == 121);

    assertDebugRefCount(testDoublePassUpInt(), 1);
    testPassInIntRef(testDoublePassUpInt(), 2);
    const doublePassedUpX = testDoublePassUpInt();
    assertDebugRefCount(doublePassedUpX, 1);
    testPassInIntRef(doublePassedUpX, 2);
}
testArcPassUp();

