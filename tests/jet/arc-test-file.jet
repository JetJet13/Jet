class SimpleClass {
    public static staticValue: int = 100;
    public value: int;

    constructor(value: int) {
        this.value = value;
    }

    public getValue(): int {
        return this.value;
    }

    public incrementValue() {
        this.value = this.value + 1;
    }

    public getTuple(): { int, () => int, bool } {
        return { 1, () => 2, false };
    }
}

class ComplexClass {
    public age: int;
    public name: string;
    public hairColor: string;

    constructor(age: int, name: string, hairColor: string) {
        this.age = age;
        this.name = name;
        this.hairColor = hairColor;
    }

    constructor(age: int) {
        this.age = age;
        this.name = "Joe";
        this.hairColor = "Black";
    }

    public getAge(): int {
        return this.age;
    }

    public getName(): string {
        return this.name;
    }

    public getHairColor(): string {
        return this.hairColor;
    }

    public static create(): ComplexClass {
        return new ComplexClass(2);
    }
}

class CircularReferenceClassA {
    private b: CircularReferenceClassB;

    constructor(otherB: CircularReferenceClassB) {
        this.b = otherB;
    }

    public getB(): CircularReferenceClassB {
        return this.b;
    }
}

class CircularReferenceClassB {
    private a: CircularReferenceClassA;

    constructor(otherA: CircularReferenceClassA) {
        this.a = otherA;
    }

    public getA(): CircularReferenceClassA {
        return this.a;
    }
}

enum SimpleEnum {
    Alpha,
    Beta,
    Gamma
}

enum StringEnum {
    Alpha = "alpha",
    Beta = "beta",
    Gamma = "gamma"
}

func getInt(x: int): int {
    return x;
}

func getFloat(y: float): float {
    return y;
}

func getBool(x: bool): bool {
    return x;
}

func getChar(y: char): char {
    return y;
}

func getString(x: string): string {
    return x;
}

func getArray(y: [int]): [int] {
    return y;
}

func getRefArray(y: [int]): ref<[int]> {
    return ref y;
}

func testTupleAccess(): string {
    const x = { 1, false, "hello" };
    return x.2;
}

type TestType = [int];

func testTupleInvocation(): { int, TestType, bool, () => string, (TestType) => int, { int, bool }, { foo: bool, bar: string } } {
    const x: { () => int } = { () => 5 };
    const y: { int } = { 5 };
    const z: { int, bool } = { 10, true };
    const a: { TestType } = { [1,2,3] };
    const b: { TestType, bool } = { [1,2,3,4], false };
    return { 1, [1,2,3], false, () => "hello", (x: TestType) => 500, { 6, false }, { foo: false, bar: "testing" } };
}

func testTupleReturnTypeTest1(): { () => string } {
    return { () => "hello" };
}

func testTupleReturnTypeTest2(): { TestType, () => string } {
    return { [1,2,3], () => "hello" };
}

func testTupleReturnTypeTest3(): { TestType } {
    return { [1,2,3] };
}

func testTupleReturnTypeTest4(): { int } {
    return { 5 };
}

func testTupleReturnTypeTest5(): { TestType, int } {
    return { [1,2,3], 900 };
}

proc testTuples() {
    const accessResult = testTupleAccess();
    print("accessResult", accessResult);
    assert(accessResult == "hello");

    const invocationResult = testTupleInvocation().3();
    print("invocationResult", invocationResult);
    assert(invocationResult == "hello");
}
testTuples();

