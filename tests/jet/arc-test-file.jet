enum SimpleEnum {
    Alpha,
    Beta,
    Gamma
}

enum StringEnum {
    Alpha = "alpha",
    Beta = "beta",
    Gamma = "gamma"
}

func getInt(x: int): int {
    return x;
}

func getFloat(y: float): float {
    return y;
}

func getBool(x: bool): bool {
    return x;
}

func getChar(y: char): char {
    return y;
}

func getString(x: string): string {
    return x;
}

func getArray(y: [int]): [int] {
    return y;
}

func getRefArray(y: [int]): shared<[int]> {
    return share y;
}

proc testShare() {
    const x = share 5;
    assert(x == 5);
    print("X", x);
    const y = x;
    assert(y.sharesWith(x));
    assert(y == x);
}
testShare();


