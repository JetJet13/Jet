import MyOtherModule from "./other-test-file.jet";
import MySecondModule from "./second-test-file.jet";
import MyThirdModule from "./third-test-file.jet";
import MyFourthModule from "./fourth-test-file.jet";

// expected delta is 25
// actual delta is 25

class SimpleClass {
    public static staticValue: int = 100;
    public value: int;

    constructor(value: int) {
        this.value = value;
    }

    public getValue() int {
        return this.value;
    }
}

class ComplexClass {
    public age: int;
    public name: string;
    public hairColor: string;

    constructor(age: int, name: string, hairColor: string) {
        this.age = age;
        this.name = name;
        this.hairColor = hairColor;
    }

    constructor(age: int) {
        this.age = age;
        this.name = "Joe";
        this.hairColor = "Black";
    }

    public getAge() int {
        return this.age;
    }

    public getName() string {
        return this.name;
    }

    public getHairColor() string {
        return this.hairColor;
    }

    public static create() ComplexClass {
        return new ComplexClass(2);
    }
}

enum SimpleEnum {
    Alpha,
    Beta,
    Gamma
}

enum StringEnum {
    Alpha = "alpha",
    Beta = "beta",
    Gamma = "gamma"
}

func getInt(x: int) int {
    return x;
}

func getFloat(y: float) float {
    return y;
}

func getBool(x: bool) bool {
    return x;
}

func getChar(y: char) char {
    return y;
}

func getString(x: string) string {
    return x;
}

func getArray(y: [int]) [int] {
    return y;
}

func getRefArray(y: [int]) ref<[int]> {
    return ref y;
}

proc testBuiltInFunctions() {
    const intExample = 101;
    print("intExample");
    print(intExample);
    print(101);

    const floatExample = 190.9011;
    print("intExample");
    print(floatExample);
    print(190.9011);

    const boolExample = true;
    print("boolExample");
    print(boolExample);
    print(true);

    const charExample = 'w';
    print("charExample");
    print(charExample);
    print('w');

    const stringExample = "hello world";
    print("stringExample");
    print(stringExample);
    print("hello world");

    const structExample = {
        a: 100,
        b: 190.90,
        c: false,
        d: 'x',
        y: "hello",
        g: "mars",
        h: [1,2,3],
        i: () => true,
        j: { 68, false, 'c' }
    };
    print("structExample");
    print(structExample);
    print({
      a: 100,
      b: 190.90,
      c: false,
      d: 'x',
      y: "hello",
      g: "mars",
      h: [1,2,3],
      i: () => true,
      j: { 68, false, 'c' },
      k: { foo: "bar" }
    });

    const tupleExample = { 100, true, false, 'c', { foo: "bar" }, { 1920, 't', 'w' } };
    print("tupleExample");
    print(tupleExample);
    print({ 100, true, false, 'c', { foo: "bar" }, { 1920, 't', 'w' } });

    const classExample = new SimpleClass(1009);
    print("classExample");
    print(classExample);
    print(new SimpleClass(1009));
    print(new ComplexClass(881));

    const arrayExample = [1,2,3];
    print("arrayExample");
    print(arrayExample);
    print([1, 2, 3]);

    const moduleExample = MySecondModule::MySecondGlobalInt;
    print("moduleExample");
    print(moduleExample);
    print(MySecondModule::MySecondGlobalInt);

    const moduleCallExample = MySecondModule::mySecondIntFunction(100);
    print("moduleCallExample");
    print(moduleCallExample);
    print(MySecondModule::mySecondIntFunction(100));

    print(intExample, floatExample, boolExample, charExample, stringExample, structExample, tupleExample, classExample, arrayExample, moduleExample, moduleCallExample);

    const simpleRange = range(4);
    assert(simpleRange == [0,1,2,3]);
    assert(range(4) == [0,1,2,3]);
    assert(range(-4) == [0, -1, -2, -3]);
    assert(range(0).empty());
    assert(range(-1) == [0]);
    assert(range(1) == range(-1));

    const medRange = range(1, 5);
    assert(medRange == [1,2,3,4]);
    assert(range(1, 5) == [1,2,3,4]);
    assert(range(-1, -5).empty());
    assert(range(-1, -1).empty());
    assert(range(-1, -1) == range(-1, -5));
    assert(range(-5, -1) == [-5, -4, -3, -2]);

    // range(start: int, end: int, step: int) - setting step to 0 will abort program
    const complexRange = range(1, 5, 3);
    assert(complexRange == [1, 4]);
    assert(range(1, 5, 3) == [1, 4]);
    assert(range(1, 5, -1).empty());
    assert(range(-5, -1, 1) == [-5, -4, -3, -2]);
    assert(range(-5, -1, -1).empty());
    assert(range(5, 1, 1).empty());

    assert(true);
    assert(true, "you'll never see this message");
    //assert(false, "you'll always see this message");

}
testBuiltInFunctions();