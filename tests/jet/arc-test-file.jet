proc testForLoops() {


    print("testing for loops");
    let numIterations = 0;
    for i in range(10) {
        print("abc,123");
        for j in range(10) {
            print("hi 456!");
            numIterations = numIterations + 1;
        }
        print("bye 456!");
    }
    assert(numIterations == 100);


}
testForLoops();

func ifStatements(x: int, y: int, z: int) int {
    if x > 1 {
        if y > 10 {
            if z > 100 {
                return 99;
            }
            return 88;
        }
        return 77;
    }
    return 66;
}

func otherIfStatements(x: int, y: int, z: int) int {
    const a = [1,2,3,4];
    if x > y {
        const b = [1,2,3,4];
        if x == 10 {
            const c = [1,2,3,4];
            return 10;
        } else {
            const d = [1,2,3,4];
            if y > 0 {
                const e = [1,2,3,4];
                return 9;
            }
            const f = [1,2,3,4];
            return 8;
        }
        const g = [1,2,3,4];
    } else if x == y {
        const h = [1,2,3,4];
        if z == 0 {
            const i = [1,2,3,4];
            return 7;
        }
        const j = [1,2,3,4];
        return 6;
    } else {
        const k = [1,2,3,4];
        if z > 100 {
            const l = [1,2,3,4];
            return 5;
        }
        const m = [1,2,3,4];
        return 4;
    }
    const n = [1,2,3,4];
}

proc testIfStatements() {
    assert(ifStatements(5, 15, 115) == 99);
    assert(ifStatements(5, 15, 98) == 88);
    assert(ifStatements(5, 9, 98) == 77);
    assert(ifStatements(0, 9, 115) == 66);
    assert(otherIfStatements(10, -15, 0) == 10);
    assert(otherIfStatements(9, 5, 0) == 9);
    assert(otherIfStatements(9, -9, 0) == 8);
    assert(otherIfStatements(9, 9, 0) == 7);
    assert(otherIfStatements(9, 9, 1) == 6);
    assert(otherIfStatements(5, 15, 105) == 5);
    assert(otherIfStatements(5, 15, 97) == 4);
}
testIfStatements();