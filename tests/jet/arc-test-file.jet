class SimpleClass {
    public static staticValue: int = 100;
    public value: int;

    constructor(value: int) {
        this.value = value;
    }

    public getValue() int {
        return this.value;
    }

    public incrementValue() {
        this.value = this.value + 1;
    }
}

class ComplexClass {
    public age: int;
    public name: string;
    public hairColor: string;

    constructor(age: int, name: string, hairColor: string) {
        this.age = age;
        this.name = name;
        this.hairColor = hairColor;
    }

    constructor(age: int) {
        this.age = age;
        this.name = "Joe";
        this.hairColor = "Black";
    }

    public getAge() int {
        return this.age;
    }

    public getName() string {
        return this.name;
    }

    public getHairColor() string {
        return this.hairColor;
    }

    public static create() ComplexClass {
        return new ComplexClass(2);
    }
}

class CircularReferenceClassA {
    private b: CircularReferenceClassB;

    constructor(otherB: CircularReferenceClassB) {
        this.b = otherB;
    }

    public getB() CircularReferenceClassB {
        return this.b;
    }
}

class CircularReferenceClassB {
    private a: CircularReferenceClassA;

    constructor(otherA: CircularReferenceClassA) {
        this.a = otherA;
    }

    public getA() CircularReferenceClassA {
        return this.a;
    }
}

enum SimpleEnum {
    Alpha,
    Beta,
    Gamma
}

enum StringEnum {
    Alpha = "alpha",
    Beta = "beta",
    Gamma = "gamma"
}

func getInt(x: int) int {
    return x;
}

func getFloat(y: float) float {
    return y;
}

func getBool(x: bool) bool {
    return x;
}

func getChar(y: char) char {
    return y;
}

func getString(x: string) string {
    return x;
}

func getArray(y: [int]) [int] {
    return y;
}

func getRefArray(y: [int]) ref<[int]> {
    return ref y;
}

proc moo() {
    const myLambdaY = (x: int, y: (int) => int) => x + y(x);
    const x = myLambdaY(5, BigModule::BIG_LAMBDA_ARROW);
    assert(x == 11);
    const y = myLambdaY(6, BigModule::BIG_LAMBDA_ARROW);
    assert(y == 13);

    const w = myLambdaY(6, BigModule::BigClass.getBigStaticLambda());
    assert(w == 14);

    const z = myLambdaY(10, getInt);
    assert(z == 20);
    const a = myLambdaY(20, BigModule::BigIntFunction);
    assert(a == 40);

    const myLambdaZ = (x: ref<BigModule::BigStruct>) => x.foo;
    const tt = myLambdaZ(BigModule::BigClass.getBigStaticStruct());
    assert(tt == 1);
}
//moo();

proc boo() {
    const myLambdaG = (x: ref<BigModule::BigStruct>) => x.foo;
    const gg = myLambdaG(BigModule::BigClass.getBigStaticStruct());
    assert(gg == 1);
}
//boo();

