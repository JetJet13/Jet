func getRefArray(y: [int]) ref<[int]> {
    return ref y;
}

proc testStructArc() {
    const myStruct = { a: 100, b: [1,2,3,4] }; // 3; 2 for struct-ref & 1 for array
    const myStructRef = ref myStruct; // 5; 2 for ref & 3 for myStruct copy
    const myArray = [1, 2, 3, 4]; // 1
    const myTuple = { true, false, 1 }; // 2
    const myTupleRef = ref myTuple; // 4
    const myClass = new SimpleClass(109); // 2
    const myClassRef = ref myClass; // 4
    const myLambda = (x: int) => 192 + x; // 2
    const myLambdaNested = (x: int) => () => 192 + x; // 2
    const result = myLambdaNested(10); // 4; 2 for returned lambda & 2 for x (captured)
    assert(result() == 202); // 0
    const capturedX = 1092; // 2
    const lambdaWithCapture = () => capturedX + 1; // 2
    assert(lambdaWithCapture() == 1093);

    // test array prototypes
    const myArray = range(15);
    myArray.append(15);
    myArray.prepend(-100);
    myArray.drop(2);
    myArray.dropLast(2);

    const takeExample = myArray.take(2);

    const takeLastExample = myArray.takeLast(2);

    const myArrayTail = myArray.tail();

    const oneIntArray = [1,2,3];
    const twoIntArray = [4,5,6];
    const concatIntResult = oneIntArray ++ twoIntArray;
    oneIntArray.drop(1);
    print(oneIntArray);
    assert(oneIntArray == [2,3]);

    const oneStructArray = [{ a: false }, { a: true }, { a: false }];
    const twoStructArray = [{ a: true }, { a: true }, { a: true }];
    const concatStructResult = oneStructArray ++ twoStructArray;
    oneStructArray.drop(1);
    print(oneStructArray);
    assert(oneStructArray == [{ a: true }, { a: false }]);
    oneStructArray.dropLast(1);
    assert(oneStructArray == [{ a: true }]);

    const oneStructBoolArray = [{ a: false }, { a: true }, { a: false }];
    oneStructBoolArray.drop(1);
    print(oneStructBoolArray);
    assert(oneStructBoolArray == [{ a: true }, { a: false }]);
    oneStructBoolArray.dropLast(1);
    assert(oneStructBoolArray == [{ a: true }]);
    oneStructBoolArray.drop(100);
    assert(oneStructBoolArray.empty());
    oneStructBoolArray.dropLast(100);
    assert(oneStructBoolArray.empty());

    const twoStructBoolArray = [{ a: true }, { a: true }, { a: true }];
    twoStructBoolArray.drop(0);
    assert(twoStructBoolArray == [{ a: true }, { a: true }, { a: true }]);
    twoStructBoolArray.dropLast(0);
    assert(twoStructBoolArray == [{ a: true }, { a: true }, { a: true }]);
}
testStructArc();

proc testPassDownStructRef(s: ref<{ a: int, b: bool }>) {
    assertDebugRefCount(s, 2);
    const localArgRef = s;
    print("localArgRef", s.a);
    assertDebugRefCount(s, 3);
}

proc testArcPassDown() {
    const s = { a: 100, b: false };
    testPassDownStructRef(ref s);
    assertDebugStructRefCount(s, 0);
    const refS = ref s;
    assertDebugRefCount(refS, 1);
}
testArcPassDown();

func testPassUpInt() ref<int> {
    const x = 121;
    return ref x;
}

proc testArcPassUp() {
    assertDebugRefCount(testPassUpInt(), 1);
    const passedUpX = testPassUpInt();
    assertDebugRefCount(passedUpX, 1);
    const anotherX = passedUpX;
    assertDebugRefCount(passedUpX, 2);
    assert(passedUpX == 121);
}
testArcPassUp();

func otherIfStatements(x: int, y: int, z: int) int {
    const arr = [1,2,3,4,5];
    if x > y {
        const helloString = "hello";
        if x == 10 {
            const bString = "hello world";
            return 10;
        } else {
            const aStruct = { foo: 89 };
            if y > 0 {
                const bStruct = { a: true };
                return 9;
            }
            const cStruct = { b: false };
            return 8;
        }
    } else if x == y {
        const uTuple = { 'a', false };
        if z == 0 {
            const zTuple = { true, 0, 1 };
            return 7;
        }
        const bTuple = { false, 10, 41 };
        return 6;
    } else {
        const aStruct = { m: 120 };
        if z > 100 {
            const bStruct = { q: 1099 };
            return 5;
        }
        const cStruct = { r: 6087 };
        return 4;
    }
}

proc testModules() {
    assert(MyOtherModule::myBoolFunction() == true);
    assert(MyOtherModule::myOtherBoolFunction() == false);
    assert(MyOtherModule::myOtherGlobalInt == 790);
    MyOtherModule::updateGlobalInt();
    assert(MyOtherModule::myOtherGlobalInt == 900);
    MyOtherModule::myOtherGlobalInt = 1290;
    assert(MyOtherModule::myOtherGlobalInt == 1290);
    assert(MyOtherModule::myOtherGlobalArray == [1,2,4,5,7,8]);
    assert(MyOtherModule::myOtherGlobalArray[0] + 1 == 2);
    assert(MyOtherModule::myOtherGlobalStruct.a == 10);
    MyOtherModule::myOtherGlobalStruct.a = 998;
    assert(MyOtherModule::myOtherGlobalStruct.a == 998);
    assert(MyOtherModule::myOtherGlobalStruct.c.nested[0] == 1);
    MyOtherModule::myOtherGlobalStruct.c.nested[0] = 44;
    assert(MyOtherModule::myOtherGlobalStruct.c.nested[0] == 44);
    assert(MyOtherModule::myOtherGlobalTuple.1 == false);
    MyOtherModule::myOtherGlobalTuple.1 = true;
    assert(MyOtherModule::myOtherGlobalTuple.1 == true);
    assert(MyOtherModule::myOtherGlobalLambda(109) == 299);
    MyOtherModule::myOtherGlobalLambda = (x: int) => x - 1;
    assert(MyOtherModule::myOtherGlobalLambda(109) == 108);
    MyOtherModule::myOtherGlobalLambda = MyOtherModule::myOtherIntFunction;
    assert(MyOtherModule::myOtherGlobalLambda(109) == 109);
    MyOtherModule::myOtherGlobalLambda = MyOtherModule::myOtherIntFunction;
    assert(MyOtherModule::myOtherGlobalLambda(109) == 109);
    assert(MySecondModule::MySecondGlobalInt == 202);
    MyOtherModule::myOtherGlobalLambda = MySecondModule::mySecondIntFunction;
    assert(MyOtherModule::myOtherGlobalLambda(109) == 109);
    assert(MyOtherModule::myOtherGlobalLambda(2) == -1);
    assert(MyFourthModule::myFourthIntFunction(MyFourthModule::MyFourthGlobalInt) == 7799);
}
//testModules();