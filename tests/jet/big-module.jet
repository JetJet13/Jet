module BigModule

export enum IntEnum {
    Alpha = 1,
    Beta = 2,
    Gamma = 3
}

export enum FloatEnum {
    Alpha = 1.1,
    Beta = 2.2,
    Gamma = 3.3
}

export enum BoolEnum {
    Alpha = true,
    Beta = false
}

export enum CharEnum {
    Alpha = 'a',
    Beta = 'b'
}

export enum StringEnum {
    Alpha = "alpha",
    Beta = "beta"
}

export type BigStruct = { foo: int, bar: bool };
export type BigTuple = { int, bool };

export class BigClass {
    private bigInt = 500;
    private bigFloat = 100.101;
    private bigBool = true;
    private bigChar = 'a';
    private bigString = "hello world";
    private bigArray = [1, 2, 3];
    private bigStruct = share { foo: 1, bar: false };
    private bigTuple = share { 1, false };
    private bigClass = share new SmallClass();
    private bigIntEnum = IntEnum.Alpha;
    private bigStringEnum = StringEnum.Alpha;
    private bigEmptyInt: int;
    // private copyThis = this; // illegal - you can't assign 'this' to a class property.

    private static bigStaticInt = 500;
    private static bigStaticFloat = 100.101;
    private static bigStaticBool = true;
    private static bigStaticChar = 'a';
    private static bigStaticString = "hello world";
    private static bigStaticArray = [1, 2, 3];
    private static bigStaticStruct = share { foo: 1, bar: false };
    private static bigStaticTuple = share { 1, false };
    private static bigStaticClass = share new SmallClass();
    private static bigStaticIntEnum = IntEnum.Alpha;
    private static bigStaticStringEnum = StringEnum.Alpha;

    constructor(x: int) {
        this.bigEmptyInt = x;
    }

    public getBigInt(): int {
        return this.bigInt;
    }

    public getBigFloat(): float {
        return this.bigFloat;
    }

    public getBigBool(): bool {
        return this.bigBool;
    }

    public getBigChar(): char {
        return this.bigChar;
    }

    public getBigString(): string {
        return this.bigString;
    }

    public getBigArray(): [int] {
        return this.bigArray;
    }

    public getBigStruct(): shared<BigStruct> {
        return this.bigStruct;
    }

    public getBigTuple(): shared<BigTuple> {
        return this.bigTuple;
    }

    public getBigStructRaw(): BigStruct {
        return dref this.bigStruct;
    }

    public getBigTupleRaw(): BigTuple {
        return dref this.bigTuple;
    }

    public getBigClass(): shared<SmallClass> {
        return this.bigClass;
    }

    public getBigIntEnum(): IntEnum {
        return this.bigIntEnum;
    }

    public getBigStringEnum(): StringEnum {
        return this.bigStringEnum;
    }

    public getBigEmptyInt(): int {
        return this.bigEmptyInt;
    }

    public getSelf(): BigClass {
        return this;
    }

    public print() {
        print(this);
    }

    public invokeAssertAll(): bool {
        const invokeInt = this.getBigInt();
        assert(invokeInt == this.bigInt);

        const invokeFloat = this.getBigFloat();
        assert(invokeFloat == this.bigFloat);

        const invokeBool = this.getBigBool();
        assert(invokeBool == this.bigBool);

        const invokeChar = this.getBigChar();
        assert(invokeChar == this.bigChar);

        const invokeString = this.getBigString();
        assert(invokeString == this.bigString);

        const invokeArray = this.getBigArray();
        assert(invokeArray == this.bigArray);

        const invokeStruct = this.getBigStruct();
        assert(invokeStruct == this.bigStruct);

        const invokeTuple = this.getBigTuple();
        assert(invokeTuple == this.bigTuple);

        const invokeStructRaw = this.getBigStructRaw();
        assert(invokeStructRaw == this.bigStruct);

        const invokeTupleRaw = this.getBigTupleRaw();
        assert(invokeTupleRaw == this.bigTuple);

        const invokeClass = this.getBigClass();
        assert(invokeClass == this.bigClass);

        const invokeIntEnum = this.getBigIntEnum();
        assert(invokeIntEnum == this.bigIntEnum);

        const invokeStringEnum = this.getBigStringEnum();
        assert(invokeStringEnum == this.bigStringEnum);

        return false;
    }

    public static getBigStaticInt(): int {
        return BigClass.bigStaticInt;
    }

    public static getBigStaticFloat(): float {
        return BigClass.bigStaticFloat;
    }

    public static getBigStaticBool(): bool {
        return BigClass.bigStaticBool;
    }

    public static getBigStaticChar(): char {
        return BigClass.bigStaticChar;
    }

    public static getBigStaticString(): string {
        return BigClass.bigStaticString;
    }

    public static getBigStaticArray(): [int] {
        return BigClass.bigStaticArray;
    }

    public static getBigStaticStruct(): shared<BigStruct> {
        return BigClass.bigStaticStruct;
    }

    public static getBigStaticTuple(): shared<BigTuple> {
        return BigClass.bigStaticTuple;
    }

    public static getBigStaticClass(): shared<SmallClass> {
        return BigClass.bigStaticClass;
    }

    public static getBigStaticIntEnum(): IntEnum {
        return BigClass.bigStaticIntEnum;
    }

    public static getBigStaticStringEnum(): StringEnum {
        return BigClass.bigStaticStringEnum;
    }

    public static getBigStaticLambda(): (int) => int {
        return (x: int) => x + 2;
    }

}

export class SmallClass {
    private smallInt = 2;
    private cc = new BigCalculator();
    private smallIntEnum = IntEnum.Alpha;
    private smallStringEnum = StringEnum.Alpha;

    constructor() {}

    public getInt(): int {
        return this.smallInt;
    }

    public setInt(x: int) {
        this.smallInt = x;
    }

    public getSelf(): SmallClass {
        return this;
    }

    public print() {
        print(this);
    }

}

export class BigCalculator {
    private value: int = 0;

    constructor() {}

    public setValue(newValue: int, instance: shared<BigCalculator>): shared<BigCalculator> {
        this.value = newValue;
        return instance;
    }

    public add(value: int, instance: shared<BigCalculator>): shared<BigCalculator> {
        this.value = this.value + value;
        return instance;
    }

    public subtract(value: int, instance: shared<BigCalculator>): shared<BigCalculator> {
        this.value = this.value - value;
        return instance;
    }

    public multiply(value: int, instance: shared<BigCalculator>): shared<BigCalculator> {
        this.value = this.value * value;
        return instance;
    }

    public getValue(): int {
        return this.value;
    }
}

export func BigFunction(): int {
    return 500;
}

export proc BigProcedure(x: shared<int>) {
    x := 100;
}

export func BigIntFunction(x: int): int {
    return x;
}

export const BIG_INT = 100;
export const BIG_FLOAT = 2.234;
export const BIG_BOOL = true;
export const BIG_CHAR = 'c';
export const BIG_STRING = "big string!";
export const BIG_ARRAY = [1, 2, 3];
export const BIG_STRUCT = { foo: 1, bar: true, mars: 2 };
export const BIG_TUPLE = { 1, false, 2 };
export const BIG_STRUCT_REF = share { foo: share 1, bar: share true, mars: share 2 };
export const BIG_TUPLE_REF = share { share 1, share false, share 2 };
export const BIG_CLASS = new SmallClass();
export const BIG_INT_ENUM = IntEnum.Alpha;
export const BIG_STRING_ENUM = StringEnum.Alpha;
export const BIG_LAMBDA_ARROW = (x: int) => x + 1;
export const BIG_LAMBDA_BLOCK = (x: int): int { return x + 1; };
export const BIG_SECOND_INT = 1019;