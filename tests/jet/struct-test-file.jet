class SimpleClass {
    public value = 10;
    public static value = 100;

    constructor() { }

    public increment() {
        this.value = this.value + 1;
    }

    public increment(newValue: int) {
        this.value = newValue;
    }

    public print() {
        print("value", this.value);
    }

    public static increment() {
        print("STATIC INCREMENT!");
    }
}

const mySimpleClass = new SimpleClass();
mySimpleClass.print();

const myLambda = (x: () => void) {
    print("magic");
    x();
};

print(mySimpleClass.print);
myLambda(mySimpleClass.increment);
myLambda(SimpleClass.increment);
SimpleClass.increment();
mySimpleClass.print();
myLambda(() => print("Boo!"));
assert(mySimpleClass.value != SimpleClass.value);

func getLambda(): (int) => int {
    const foo = 100; // captured variable
    return (x: int) {
      if x > 10 {
        return foo;
      }
      return x + 1;
    };
}

const otherLambda = getLambda();
assert(otherLambda(50) == 100);
print("otherLambda", otherLambda(50));