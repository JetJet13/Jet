import MyOtherModule from "./other-test-file.jet";

func handleCapturedLambda(lambda: () => int) int {
    const vv = lambda();
    return vv + 1;
}

proc testCapturedLambda() {
    const x = () { return 20; };
    const y = () { return 100 + x(); };
    const result = handleCapturedLambda(y);
    assert(result == 121);
    print("result", result);
    const secondResult = handleCapturedLambda(() => 1920);
    assert(secondResult == 1921);
    print("secondResult", secondResult);
    const thirdResult = handleCapturedLambda(() {
        const x = 10;
        const wow = () => 100;
        return x + wow() + secondResult;
    });
    assert(thirdResult == 2032);
    print("thirdResult", thirdResult);
}

proc testWhileLoop() {
    let index = 0;
    while index < 5 {
        print("Index", index);
        index = index + 1;
    }
}

testCapturedLambda();
//testWhileLoop();

class MyClass {
    public age: int;
    public color: string;
    private foo = 100;
    private other = new OtherClass();

    constructor(age: int, color: string) {
        this.age = age;
        this.color = color;
    }

    public getFoo() int {
        return this.foo;
    }

    public getAge() int {
        return this.age;
    }

    public getColor() string {
        return this.color;
    }

    public changeColor(newColor: string) {
        this.color = newColor;
    }

    public incrementAge() {
        this.age = this.age + 1;
    }

    public setOtherValue(newValue: int) {
        this.other.setValue(newValue);
    }

    public printOtherValue() {
        print(this.other.getValue());
    }

}

class OtherClass {
    public value: int = 100;

    constructor() {}

    public getValue() int {
        return this.value;
    }

    public setValue(newValue: int) {
        this.value = newValue;
    }
}

enum MyEnum {
 Alpha = 1,
 Beta = 2,
 Gamma = 3
}

enum MyStrEnum {
 Foo = "foo",
 Bar = "bar",
 Mars = "mars"
}