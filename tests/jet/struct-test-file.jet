import MyOtherModule from "./other-test-file.jet";

func handleCapturedLambda2(lambda: () => int, secondLambda: () => string) int {
    const vv = lambda();
    print("SECOND LAMBDA", secondLambda() ++ "_WOW!");
    return vv + 1;
}

proc testCapturedLambda2() {
    const x = () { return 20; };
    assertDebugLambdaRefCount(x, 2);
    const y = () { return 100 + x(); };
    const result = handleCapturedLambda2(y, () => "WOW");
    assert(result == 121);
    print("result", result);
    const secondResult = handleCapturedLambda2(() => 1920, () => "Word");
    assert(secondResult == 1921);
    print("secondResult", secondResult);
    const thirdResult = handleCapturedLambda2(
        () {
            const x = 10;
            const wow = () => 100;
            return x + wow() + secondResult;
        },
        () {
            return "Naga!";
        }
    );
    assert(thirdResult == 2032);
    print("thirdResult", thirdResult);
}

proc testWhileLoop() {
    let index = 0;
    while index < 5 {
        print("Index", index);
        index = index + 1;
    }
}

proc testConcat() {
    const momo = [1,2,3] ++ [5,2,1] ++ [9,9,9];
    print(momo);
    const strConcat = "Hello " ++ "World" ++ " Wow!";
    print(strConcat);
    const structConcat = [{ foo: 10 }] ++ [{ foo: 20 }];
    print(structConcat);
    assertDebugStructRefCount(structConcat[0], 1);
    const myStruct = { mars: 100 };
    assertDebugStructRefCount(myStruct, 0);
    const charStructConcat = [{ foo: 'q' }] ++ [{ foo: 'a' }];
    print(charStructConcat);
    const tupleConcat = [{ 10, true, 'c' }] ++ [{ 20, false, 'b' }];
    print(tupleConcat);

    // ref
    const momoRef = ref [1,2,3] ++ ref [5,2,1] ++ ref [9,9,9];
    print(momoRef);
    assertDebugRefCount(momoRef, 1);
    const strConcatRef = ref "Hello " ++ ref "World" ++ ref " Wow!";
    print(strConcatRef);
    const structConcatRef = [ref { foo: 10 }] ++ [ref { foo: 20 }];
    print(structConcatRef);
    const tupleConcatRef = [ref { 10, true, 'c' }] ++ [ref { 20, false, 'b' }];
    print(tupleConcatRef);

    const arrayRefValues = [ref { foo: 100 }];
    const secondArrayRefValues = [ref { foo: 200 }];
    const concatResult = arrayRefValues ++ secondArrayRefValues;
    print("concatResult", concatResult);
    const mars = ref dref concatResult[0];
    concatResult[0].foo = 350;
    assert(mars.foo == 100);
    assert(concatResult[0].foo == arrayRefValues[0].foo);
    assert(concatResult[0].foo != mars.foo);
    print("mars", mars);
    print("fooValue", concatResult[0].foo, arrayRefValues[0].foo, "mars.foo", mars.foo);
    const refStructCopy = concatResult[0];
    refStructCopy.foo = 900;
    print("refStructCopy", refStructCopy, concatResult[0].foo);
}

proc testPrintLambda() {
    print(() => 120);
    print(() {});
    print(() { return 100; });
}

testCapturedLambda2();
testWhileLoop();
testConcat();
testPrintLambda();

class MyClass {
    public age: int;
    public color: string;
    private foo = 100;
    private other = new OtherClass();

    constructor(age: int, color: string) {
        this.age = age;
        this.color = color;
    }

    public getFoo() int {
        return this.foo;
    }

    public getAge() int {
        return this.age;
    }

    public getColor() string {
        return this.color;
    }

    public changeColor(newColor: string) {
        this.color = newColor;
    }

    public incrementAge() {
        this.age = this.age + 1;
    }

    public setOtherValue(newValue: int) {
        this.other.setValue(newValue);
    }

    public printOtherValue() {
        print(this.other.getValue());
    }

}

class OtherClass {
    public value: int = 100;

    constructor() {}

    public getValue() int {
        return this.value;
    }

    public setValue(newValue: int) {
        this.value = newValue;
    }
}

enum MyEnum {
 Alpha = 1,
 Beta = 2,
 Gamma = 3
}

enum MyStrEnum {
 Foo = "foo",
 Bar = "bar",
 Mars = "mars"
}
