import MyOtherModule from "./other-test-file.jet";

class SimpleClass {
    public static staticValue: int = 100;
    public value: int;

    constructor(value: int) {
        this.value = value;
    }

    public getValue() int {
        return this.value;
    }
}

class ComplexClass {
    public age: int;
    public name: string;
    public hairColor: string;

    constructor(age: int, name: string, hairColor: string) {
        this.age = age;
        this.name = name;
        this.hairColor = hairColor;
    }

    constructor(age: int) {
        this.age = age;
        this.name = "Joe";
        this.hairColor = "Black";
    }

    public getAge() int {
        return this.age;
    }

    public getName() string {
        return this.name;
    }

    public getHairColor() string {
        return this.hairColor;
    }

    public static create() ComplexClass {
        return new ComplexClass(2);
    }
}

enum SimpleEnum {
    Alpha,
    Beta,
    Gamma
}

func getInt(x: int) int {
    return x;
}

func getFloat(y: float) float {
    return y;
}

func getBool(x: bool) bool {
    return x;
}

func getChar(y: char) char {
    return y;
}

func getString(x: string) string {
    return x;
}

func getArray(y: [int]) [int] {
    return y;
}

func getRefArray(y: [int]) ref<[int]> {
    return ref y;
}

func functionUsedAsLambda(x: int) int {
    return x + 1000;
}

proc testFunctionsAsLambdas() {
    const lambdaUsingFunction = (x: int, l: (int) => int) {
        return l(x) + 1000;
    };

    const result = lambdaUsingFunction(1, functionUsedAsLambda);
    assert(result == 2001);
}
testFunctionsAsLambdas();

proc procUsedAsLambda(x: ref<int>) {
    x := x + 1;
}

proc testProceduresAsLambdas() {
    const lambdaUsingProcedure = (x: ref<int>, l: (ref<int>) => void) {
        x := x + 10;
        l(x);
    };

    const x = ref 1;
    lambdaUsingProcedure(x, procUsedAsLambda);
    assert(x == 12);
}
testProceduresAsLambdas();