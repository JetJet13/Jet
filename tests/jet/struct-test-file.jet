import MyOtherModule from "./other-test-file.jet";

class SimpleClass {
    public static staticValue: int = 100;
    public value: int;

    constructor(value: int) {
        this.value = value;
    }

    public getValue() int {
        return this.value;
    }
}

class ComplexClass {
    public age: int;
    public name: string;
    public hairColor: string;

    constructor(age: int, name: string, hairColor: string) {
        this.age = age;
        this.name = name;
        this.hairColor = hairColor;
    }

    constructor(age: int) {
        this.age = age;
        this.name = "Joe";
        this.hairColor = "Black";
    }

    public getAge() int {
        return this.age;
    }

    public getName() string {
        return this.name;
    }

    public getHairColor() string {
        return this.hairColor;
    }

    public static create() ComplexClass {
        return new ComplexClass(2);
    }
}

enum SimpleEnum {
    Alpha,
    Beta,
    Gamma
}

func getInt(x: int) int {
    return x;
}

func getFloat(y: float) float {
    return y;
}

func getBool(x: bool) bool {
    return x;
}

func getChar(y: char) char {
    return y;
}

func getString(x: string) string {
    return x;
}

func getArray(y: [int]) [int] {
    return y;
}

func getRefArray(y: [int]) ref<[int]> {
    return ref y;
}

proc testRange() {
    for i in range(10) {
        print(i);
    }

    for i in range(2, 8) {
        print(i);
    }

    for i in range(12, 22, 2) {
        print(i);
    }
}

proc testStringPrototype() {
    let myString = "hello-world";
    myString.drop(1);
    assert(myString == "ello-world");
    myString.dropLast(2);
    assert(myString == "ello-wor");
    myString.dropLast(100);
    assert(myString == "");
    myString = "hello-world";
    myString.drop(100);
    assert(myString == "");
    assert(myString.empty());
    assert(myString.size() == 0);
    assert(myString.tail() == "");
    assert(myString.take(5) == "");
    assert(myString.takeLast(5) == "");
    assert(myString.take(0) == "");
    assert(myString.takeLast(0) == "");

    const otherString = "my-other-string";
    assert(!otherString.empty());
    assert(otherString.at(0) == 'm');
    assert(otherString.at(1) == 'y');
    assert(otherString.at(14) == 'g');
    assert(otherString.size() == 15);
    assert(otherString.tail() == "y-other-string");
    assert(otherString.take(5) == "my-ot");
    assert(otherString.takeLast(5) == "tring");
    assert(otherString.take(0) == "");
    assert(otherString.takeLast(0) == "");

    const shortString = "aq";
    assert(shortString.tail() == "q");
    assert(shortString.take(100) == "aq");
    assert(shortString.takeLast(100) == "aq");
    assert(shortString.take(0) == "");
    assert(shortString.takeLast(0) == "");
    shortString.prepend('m');
    assert(shortString == "maq");
    shortString.append('q');
    assert(shortString == "maqq");

}
testStringPrototype();