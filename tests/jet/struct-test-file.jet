import MyThirdModule from "./third-test-file.jet";

class SimpleClass {
    public value = 10;
    public static value = 100;

    constructor() { }

    public increment() {
        this.value = this.value + 1;
    }

    public increment(newValue: int) {
        this.value = newValue;
    }

    public print() {
        print("value", this.value);
    }

    public static increment() {
        print("STATIC INCREMENT!");
    }
}

const mySimpleClass = new SimpleClass();
mySimpleClass.print();

const myLambda = (x: () => void) {
    print("magic");
    x();
};

print(mySimpleClass.print);
myLambda(mySimpleClass.increment);
myLambda(SimpleClass.increment);
SimpleClass.increment();
mySimpleClass.print();
myLambda(() => print("Boo!"));
assert(mySimpleClass.value != SimpleClass.value);

// TODO - test module access expressions to confirm if the logic can infer the correct exported module object
// similar to how it works for class methods
const result = MyThirdModule::myThirdIntFunction();
const otherResult = MyThirdModule::myThirdIntFunction(5);
assert(result != otherResult);
print(result, otherResult);