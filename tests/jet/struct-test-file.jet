class SimpleClass {
    public value = 10;

    constructor() { }

    public increment() {
        this.value = this.value + 1;
    }

    public increment(newValue: int) {
        this.value = newValue;
    }

    public print() {
        print("value", this.value);
    }

// in order to support this, you need to
// ensure unique method names in llvm by adding
// a suffix like 'static'
    public static increment() {
        print("STATIC INCREMENT!");
    }
}

const mySimpleClass = new SimpleClass();
mySimpleClass.print();

const myLambda = (x: () => void) {
    print("magic");
    x();
};

print(mySimpleClass.print);
myLambda(mySimpleClass.increment);
//myLambda(SimpleClass.increment);
SimpleClass.increment();
mySimpleClass.print();
myLambda(() => print("Boo!"));
