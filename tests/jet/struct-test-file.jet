import MyOtherModule from "./other-test-file.jet";

class SimpleClass {
    public value: int;

    constructor(value: int) {
        this.value = value;
    }

    public getValue() int {
        return this.value;
    }
}

class ComplexClass {
    public age: int;
    public name: string;
    public hairColor: string;

    constructor(age: int, name: string, hairColor: string) {
        this.age = age;
        this.name = name;
        this.hairColor = hairColor;
    }

    public getValue() int {
        return this.age;
    }

    public getName() string {
        return this.name;
    }
}

enum SimpleEnum {
    Alpha,
    Beta,
    Gamma
}

func getInt(x: int) int {
    return x;
}

func getFloat(y: float) float {
    return y;
}

func getBool(x: bool) bool {
    return x;
}

func getChar(y: char) char {
    return y;
}

func getString(x: string) string {
    return x;
}

func getArray(y: [int]) [int] {
    return y;
}

func getRefArray(y: [int]) ref<[int]> {
    return ref y;
}

proc testWhileLoops() {
    let value = 10;
    while value > 0 {
        value = value - 1;
    }
    assert(value == 0);

    let refValue = ref 10;
    while refValue > 0 {
        refValue *= refValue - 1;
    }
    assert(refValue == 0);
}
testWhileLoops();