class SimpleClass {
    constructor() {}

    public mick() {
        print("mick");
    }

    private mack() {
        print("mack");
    }

    public static foo() {
        print("foo");
    }

    private static bar() {
        print("bar");
    }
}

SimpleClass.foo();
SimpleClass.bar();

const x = new SimpleClass();
x.mick();
x.mack();

