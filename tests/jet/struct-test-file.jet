import MyOtherModule from "./other-test-file.jet";

class SimpleClass {
    public value: int;

    constructor(value: int) {
        this.value = value;
    }

    public getValue() int {
        return this.value;
    }
}

class ComplexClass {
    public age: int;
    public name: string;
    public hairColor: string;

    constructor(age: int, name: string, hairColor: string) {
        this.age = age;
        this.name = name;
        this.hairColor = hairColor;
    }

    public getValue() int {
        return this.age;
    }

    public getName() string {
        return this.name;
    }
}

enum SimpleEnum {
    Alpha,
    Beta,
    Gamma
}

proc testWhileLoops() {
    let ifWhileCounter = 20;
    let evenCounter = 0;
    let oddCounter = 0;
    while ifWhileCounter > 0 {
        if ifWhileCounter mod 2 == 0 {
            evenCounter = evenCounter + 1;
        } else {
            oddCounter = oddCounter + 1;
        }
        ifWhileCounter = ifWhileCounter - 1;
    }
    assert(evenCounter == 10);
    assert(oddCounter == 10);
}
testWhileLoops();