proc main() {
    const x = range(10);
    for item in x {
        print(item);
    }
    const z = range(10, 15, 2);
    for item in z {
        print(item);
    }
    const negX = range(-10);
    for item in negX {
        print(item);
    }
    const negZ = range(-10, -15, 1);
    for item in negZ {
        print(item); // should print nothing since negZ is empty.
    }
    print('b', 'v', 104, "HELLO!", true, false, true, false, 10009, 'c', 100, 200, 300, 400, 500, 600, 700, 800, 900, 1000, 1100, 1200);
}

proc maino() {
    const m = [1,2,3];
    const x = 999;
    const y = 6;
    print(y);
    print(x);
    print(y);
    print(x);
    print(y, x, y);
    print(99, 22, 29, 44, 55, 66, 77, 88, 99);
    print(true, false, true, false, true);
    print('a', 'b', 'c', 'd', 'e');
    print("Al", "Bob", "Chris", "Dom", "Eric");
    print(200, "Al", true, 'c', false, "Eric", 90.092);
    print(m[1], 20);
    print(y, y, y);
    print(y, y, y);
    print(22);
    print(54.290);
    print('c');
    print(true);
    print(false);
    print("moo");
}

proc testArrayPrototypeFunctions() {
    print("--- my array prototype ---");
    const myArray = range(15);
    print("at index 1:", myArray[1]);
    print("size", myArray.size());
    //myArray.append(15);
    print("newSize (after append)", myArray.size());
    print("newValue", myArray[14], myArray[15]);
    //myArray.prepend(-100);
    print("newSize (after prepend)", myArray.size());
    print("newValue", myArray[1], myArray[0]);

    myArray.drop(2);
    print("newSize (after drop 2)", myArray.size());
    print("newValue", myArray[0], myArray[1], myArray[12], myArray[13]);

    myArray.dropLast(2);
    print("newSize (after dropLast 2)", myArray.size());
    print("newValue", myArray[0], myArray[10], myArray[11], myArray[12], myArray[13], myArray[14], myArray[15]);

    const takeExample = myArray.take(2);
    print("takeExample", takeExample[0], takeExample[1]);

    const takeLastExample = myArray.takeLast(2);
    print("takeLastExample", takeLastExample[0], takeLastExample[1]);

    const headExample = myArray.head();
    const sumHeadExample = headExample + 100;
    print("head", headExample, sumHeadExample);

    const lastExample = myArray.last();
    const sumLastExample = lastExample + 100;
    print("last", lastExample, sumLastExample);

    const myArrayTail = myArray.tail();
    print("myArrayTail", myArrayTail.size(), myArrayTail[0], myArrayTail[1]);

    const oneArray = [1,2,3];
    const twoArray = [4,5,6];
    const concatResult = oneArray ++ twoArray;
    print("concatResult", concatResult.size());
    for item in concatResult {
        print("concatItem", item);
    }

    const emptyArray: [int] = [];
    print("test array.isEmpty():", emptyArray.empty(), oneArray.empty());
}

proc testCopyFunctions() {
    const x = 50;
    const xCopy = x;
    print("x", x, xCopy);
    const y = 20.204;
    const yCopy = y;
    print("y", y, yCopy);
    const z = 'c';
    const zCopy = z;
    print("z", z, zCopy);
    const b = true;
    const bCopy = b;
    print("b", b, bCopy);
    const s = "hello world";
    const sCopy = s;
    print("s", s, sCopy);
    const t = { foo: 10, bar: false };
    const tCopy = t;
    print("t", t.foo, t.bar, tCopy.foo, tCopy.bar);
    const a = [1,2,3,4,5];
    const aCopy = a;
    print("a", a.size(), a[0], a[4], "|", aCopy.size(), aCopy[0], aCopy[4]);
    const v = { true, 'c', 800 };
    const vCopy = v;
    print("v", v.0, v.1, v.2, "|", vCopy.0, vCopy.1, vCopy.2);
}

proc testRefFunctions() {
    let x = 50;
    const refX = ref x;
    const srefX = sref refX;
    const y = dref refX;
    print("refX", x, refX, srefX, y);
    x = 45;
    print("refX (after update)", x, refX, srefX, y);
}

proc testCopyParameterFunctions(x: int, y: float, z: bool, a: [int], b: { foo: string, bar: bool }) {
    const myX = x;
    const myY = y;
    const myZ = z;
    const myA = a;
    const myB = b;
    print(myX, myY, myZ, myA.size(), myA[0], myB.foo, myB.bar);
    // todo - add end-to-end support for object-access assignment
    // refer to array access assignment for reference
    myB.foo = "new foo!";
    print("b foo:", b.foo, "myB.foo:", myB.foo);
}
//main();
maino();
testArrayPrototypeFunctions();
testCopyFunctions();
testRefFunctions();
testCopyParameterFunctions(5, 11.32, true, [7,8,9], { foo: "hello world", bar: false });