proc SimpleProc(fooLambda: func<int> => int) {
    const simple = 50;
    const simpleLambda = () => 50;
    const anotherLambda = () => simple + simpleLambda() + fooLambda();
    const pen = anotherLambda();
}

func SimpleFunc(fooLambda: func<int> => int) int {
    const simple = 50;
    const simpleLambda = () => 50;
    const anotherLambda = (x: int, y: func<int> => int) => x + y(88) + simple + simpleLambda() + fooLambda();
    return anotherLambda(20, (z: int) => z + 2) + anotherLambda(20, (z: int) { return z + 2; });
}

func LambdaVarTest(test: func<> => int) int {
    return 5 + test();
}

func FooVarTest() int {
    const fooLambdaTest = () => 25;
    return LambdaVarTest(fooLambdaTest);
}

class MyClass {

    public a: int = 5;
    public b = { x: 10, y: 0, z: 97 };
    private c = tuple { 1, 2, 3 };
    private d: int;
    private e = this.computeValueForE();
    // private lambda = () => 20; illegal, since they're equivalent to class methods

    constructor(dValue: int) {
        const constructorLambda = () => 200;
        this.d = dValue;
    }

    public getA(callback: func<> => int) int {
        return this.a + this.b.x + this.c.2 + callback() + this.compute();
    }

    private compute() int {
        const computeLambda = () => this.a + 5;
        this.a = 20 + 5;
        return this.getA(() => 20) + this.getA(computeLambda);
    }

    private computeValueForE() int {
        return 19;
    }
}

const myClassInstance = new MyClass(5);