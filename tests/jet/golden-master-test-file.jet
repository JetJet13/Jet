proc testBigModule() {
    const bigInstance = new BigModule::BigClass(10);
    bigInstance.invokeAssertAll();
    assert(bigInstance == bigInstance.getSelf());
    assert(bigInstance.getBigInt() == 500);
    assert(bigInstance.getBigFloat() == 100.101);
    assert(bigInstance.getBigBool() == true);
    assert(bigInstance.getBigChar() == 'a');
    assert(bigInstance.getBigString() == "hello world");
    assert(bigInstance.getBigArray() == [1, 2, 3]);
    assert(bigInstance.getBigStruct() == { foo: 1, bar: false });
    assert(bigInstance.getBigTuple() == { 1, false });
    assert(bigInstance.getBigClass() == new BigModule::SmallClass());
    assert(bigInstance.getBigIntEnum() == BigModule::IntEnum.Alpha);
    assert(bigInstance.getBigStringEnum() == BigModule::StringEnum.Alpha);
    assert(bigInstance.getBigEmptyInt() == 10);

    const bigFunctionResult = BigModule::BigFunction();
    assert(bigFunctionResult == 500);

    const x = ref 190;
    BigModule::BigProcedure(x);
    assert(x == 100);

    const bigInt = BigModule::BigClass.getBigStaticInt();
    assert(bigInt == 500);

    const bigFloat = BigModule::BigClass.getBigStaticFloat();
    assert(bigFloat == 100.101);

    const bigBool = BigModule::BigClass.getBigStaticBool();
    assert(bigBool == true);

    const bigChar = BigModule::BigClass.getBigStaticChar();
    assert(bigChar == 'a');

    const bigString = BigModule::BigClass.getBigStaticString();
    assert(bigString == "hello world");

    const bigArray = BigModule::BigClass.getBigStaticArray();
    assert(bigArray == [1, 2, 3]);

    const bigStruct: ref<BigModule::BigStruct> = BigModule::BigClass.getBigStaticStruct();
    assert(bigStruct == { foo: 1, bar: false });

    const bigTuple: ref<BigModule::BigTuple> = BigModule::BigClass.getBigStaticTuple();
    assert(bigTuple == { 1, false });

    const bigStaticClass = BigModule::BigClass.getBigStaticClass();
    assert(bigStaticClass == new BigModule::SmallClass());

    const bigStaticIntEnum = BigModule::BigClass.getBigStaticIntEnum();
    assert(bigStaticIntEnum == BigModule::IntEnum.Alpha);

    const bigStaticStringEnum = BigModule::BigClass.getBigStaticStringEnum();
    assert(bigStaticStringEnum == BigModule::StringEnum.Alpha);

    const bigStaticLambda = BigModule::BigClass.getBigStaticLambda();
    assert(bigStaticLambda(10) == 12);

    assert(BigModule::BIG_INT == 100);
    assert(BigModule::BIG_FLOAT == 2.234);
    assert(BigModule::BIG_BOOL == true);
    assert(BigModule::BIG_CHAR == 'c');
    assert(BigModule::BIG_STRING == "big string!");
    assert(BigModule::BIG_ARRAY == [1, 2, 3]);
    assert(BigModule::BIG_STRUCT == { foo: 1, bar: true, mars: 2 });
    assert(BigModule::BIG_TUPLE == { 1, false, 2 });
    assert(BigModule::BIG_CLASS == new BigModule::SmallClass());
    assert(BigModule::BIG_INT_ENUM == BigModule::IntEnum.Alpha);
    assert(BigModule::BIG_STRING_ENUM == BigModule::StringEnum.Alpha);
    assert(BigModule::BIG_LAMBDA_ARROW(120) == 121);
    assert(BigModule::BIG_LAMBDA_BLOCK(120) == 121);

    const myLambda = (x: int, y: (int) => int) => x + y(x);
    assert(myLambda(5, BigModule::BIG_LAMBDA_ARROW) == 11);
    assert(myLambda(5, BigModule::BIG_LAMBDA_BLOCK) == 11);
    const lambdaResult = myLambda(5, BigModule::BIG_LAMBDA_ARROW);
    assert(lambdaResult == 11);
    const lambdaResult2 = myLambda(6, BigModule::BIG_LAMBDA_ARROW);
    assert(lambdaResult2 == 13);

    const w = myLambda(6, BigModule::BigClass.getBigStaticLambda());
    assert(w == 14);

    const z = myLambda(10, getInt);
    assert(z == 20);
    const a = myLambda(20, BigModule::BigIntFunction);
    assert(a == 40);

    const myLambdaStruct = (x: ref<BigModule::BigStruct>) => x.foo;
    const lambdaStructResult = myLambdaStruct(BigModule::BigClass.getBigStaticStruct());
    assert(lambdaStructResult == 1);

    const copyBigInt = BigModule::BIG_INT;
    const copyBigFloat = BigModule::BIG_FLOAT;
    const copyBigBool = BigModule::BIG_BOOL;
    const copyBigChar = BigModule::BIG_CHAR;

    const copyBigString = BigModule::BIG_STRING;
    copyBigString.dropLast(1);
    assert(copyBigString == "big string");
    assert(BigModule::BIG_STRING == "big string!");

    const copyBigArray = BigModule::BIG_ARRAY;
    copyBigArray.dropLast(1);
    assert(copyBigArray == [1,2]);
    assert(BigModule::BIG_ARRAY == [1, 2, 3]);

    const copyBigStruct = BigModule::BIG_STRUCT;
    copyBigStruct.foo = 20;
    assert(copyBigStruct == { foo: 20, bar: true, mars: 2 });
    assert(BigModule::BIG_STRUCT == { foo: 1, bar: true, mars: 2 });

    const copyBigTuple = BigModule::BIG_TUPLE;
    copyBigTuple.0 = 20;
    assert(copyBigTuple == { 20, false, 2 });
    assert(BigModule::BIG_TUPLE == { 1, false, 2 });

    const copyBigClass = BigModule::BIG_CLASS;
    copyBigClass.setInt(20);
    assert(copyBigClass.getInt() == 20);
    assert(BigModule::BIG_CLASS.getInt() == 2);

    let copyBigIntEnum = BigModule::BIG_INT_ENUM;
    copyBigIntEnum = BigModule::IntEnum.Beta;
    assert(copyBigIntEnum == BigModule::IntEnum.Beta);
    assert(BigModule::BIG_INT_ENUM == BigModule::IntEnum.Alpha);

    let copyBigStringEnum = BigModule::BIG_STRING_ENUM;
    copyBigStringEnum = BigModule::StringEnum.Beta;
    assert(copyBigStringEnum == BigModule::StringEnum.Beta);
    assert(BigModule::BIG_STRING_ENUM == BigModule::StringEnum.Alpha);

    let copyBigLambdaArrow = BigModule::BIG_LAMBDA_ARROW;
    copyBigLambdaArrow = (y: int) => 900 + y;
    assert(copyBigLambdaArrow != BigModule::BIG_LAMBDA_ARROW);

    let copyBigLambdaBlock = BigModule::BIG_LAMBDA_BLOCK;
    copyBigLambdaBlock = (y: int) { return 900 + y; };
    assert(copyBigLambdaBlock != BigModule::BIG_LAMBDA_BLOCK);

    const smallInstance = ref new BigModule::SmallClass();
    assert(smallInstance == smallInstance.getSelf());
    print(smallInstance);
    smallInstance.print();

    const bigCalculator = ref new BigModule::BigCalculator();
    bigCalculator
    .setValue(1, bigCalculator)
    .add(2, bigCalculator)
    .add(6, bigCalculator)
    .subtract(1, bigCalculator)
    .multiply(3, bigCalculator);
    assert(bigCalculator.getValue() == 24);
}
testBigModule();

proc testBigModule2() {
    const myLambda = (x: ref<BigModule::BigStruct>) => x.foo;
    const result = myLambda(BigModule::BigClass.getBigStaticStruct());
    assert(result == 1);
}
testBigModule2();

type TestType = [int];

func testTupleAccess(): string {
    const x = { 1, false, "hello" };
    return x.2;
}

func testTupleInvocation(): { int, TestType, bool, () => string, (TestType) => { int, TestType }, { int, bool }, { foo: bool, bar: string } } {
    const x: { () => int } = { () => 5 };
    const y: { int } = { 5 };
    const z: { int, bool } = { 10, true };
    const a: { TestType } = { [1,2,3] };
    const b: { TestType, bool } = { [1,2,3,4], false };
    return { 1, [1,2,3], false, () => "hello", (x: TestType) => { 500, x }, { 6, false }, { foo: false, bar: "testing" } };
}

func testRefTupleInvocation(): ref<{ int, TestType, bool, () => string, (TestType) => { int, TestType }, { int, bool }, { foo: bool, bar: string } }> {
    const x: { () => int } = { () => 5 };
    const y: { int } = { 5 };
    const z: { int, bool } = { 10, true };
    const a: { TestType } = { [1,2,3] };
    const b: { TestType, bool } = { [1,2,3,4], false };
    return ref { 1, [1,2,3], false, () => "hello", (x: TestType) => { 500, x }, { 6, false }, { foo: false, bar: "testing" } };
}

func testTupleReturnTypeTest1(): { () => string } {
    return { () => "hello" };
}

func testTupleReturnTypeTest2(): { TestType, () => string } {
    return { [1,2,3], () => "hello" };
}

func testTupleReturnTypeTest3(): { TestType } {
    return { [1,2,3] };
}

func testTupleReturnTypeTest4(): { int } {
    return { 5 };
}

func testTupleReturnTypeTest5(): { TestType, int } {
    return { [1,2,3], 900 };
}

func testTupleReturnTypeTest6(): [{ TestType, int }] {
    return [{ [1,2,3], 900 }];
}

type MyTestTuple = { ref<int>, ref<bool> };

func passDownTuple(): MyTestTuple {
    return { ref 5, ref false };
}

proc updateTuple(a: ref<int>, b: ref<bool>) {
    const anotherRefA = a;
    a := 50;
    b := true;
    assert(anotherRefA == 50);
}

proc testTuples() {
    const accessResult = testTupleAccess();
    print("accessResult", accessResult);
    assert(accessResult == "hello");
    const invocationResult = testTupleInvocation().3();
    print("invocationResult", invocationResult);
    assert(invocationResult == "hello");

    const refInvocationResult = testRefTupleInvocation().3();
    print("refInvocationResult", refInvocationResult);
    assert(refInvocationResult == "hello");

    const passedDownTuple = passDownTuple();
    assert(passedDownTuple.0 == 5);
    assert(passedDownTuple.1 == false);
    const refA = passedDownTuple.0;
    const refB = passedDownTuple.1;
    updateTuple(refA, refB);
    assert(passedDownTuple.0 == 50);
    assert(passedDownTuple.1 == true);
}
testTuples();

func testStructAccess(): string {
    const x = { a: 1, b: false, c: "hello" };
    return x.c;
}

func testStructInvocation(): { a: int, b: TestType, c: bool, d: () => string, e: (TestType) => { a: int, b: TestType }, f: { int, bool }, g: { foo: bool, bar: string } } {
    const x: { a: () => int } = { a: () => 5 };
    const y: { a: int } = { a: 5 };
    const z: { a: int, b: bool } = { a: 10, b: true };
    const a: { a: TestType } = { a: [1,2,3] };
    const b: { a: TestType, b: bool } = { a: [1,2,3,4], b: false };
    return { a: 1, b: [1,2,3], c: false, d: () => "hello", e: (x: TestType) => { a: 500, b: x }, f: { 6, false }, g: { foo: false, bar: "testing" } };
}

func testRefStructInvocation(): ref<{ a: int, b: TestType, c: bool, d: () => string, e: (TestType) => { a: int, b: TestType }, f: { int, bool }, g: { foo: bool, bar: string } }> {
    const x: { a: () => int } = { a: () => 5 };
    const y: { a: int } = { a: 5 };
    const z: { a: int, b: bool } = { a: 10, b: true };
    const a: { a: TestType } = { a: [1,2,3] };
    const b: { a: TestType, b: bool } = { a: [1,2,3,4], b: false };
    return ref { a: 1, b: [1,2,3], c: false, d: () => "hello", e: (x: TestType) => { a: 500, b: x }, f: { 6, false }, g: { foo: false, bar: "testing" } };
}

func testStructReturnTypeTest1(): { a: () => string } {
    return { a: () => "hello" };
}

func testStructReturnTypeTest2(): { a: TestType, b: () => string } {
    return { a: [1,2,3], b: () => "hello" };
}

func testStructReturnTypeTest3(): { a: TestType } {
    return { a: [1,2,3] };
}

func testStructReturnTypeTest4(): { a: int } {
    return { a: 5 };
}

func testStructReturnTypeTest5(): { a: TestType, b: int } {
    return { a: [1,2,3], b: 900 };
}

func testStructReturnTypeTest6(): [{ a: TestType, b: int }] {
    return [{ a: [1,2,3], b: 900 }];
}

type MyTestStruct = { a: ref<int>, b: ref<bool> };
func passDownStruct(): MyTestStruct {
    return { a: ref 5, b: ref false };
}

proc updateStruct(a: ref<int>, b: ref<bool>) {
    const anotherRefA = a;
    a := 50;
    b := true;
    assert(anotherRefA == 50);
}

proc testStructs() {
    const accessResult = testStructAccess();
    assert(accessResult == "hello");
    const invocationResult = testStructInvocation().d();
    assert(invocationResult == "hello");

    const refInvocationResult = testRefStructInvocation().d();
    assert(refInvocationResult == "hello");

    const passedDownStruct = passDownStruct();
    assert(passedDownStruct.a == 5);
    assert(passedDownStruct.b == false);
    const refA = passedDownStruct.a;
    const refB = passedDownStruct.b;
    updateStruct(refA, refB);
}
testStructs();

proc assignParameterTest(val: int, expectedVal: int) {
    const x = val;
    assert(x == val);
    val = x + 1;
    assert(x != val);
    assert(val == expectedVal);
}
assignParameterTest(4, 5);