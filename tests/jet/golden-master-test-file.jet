proc testWhileLoops() {
    let value = 10;
    while value > 0 {
        value = value - 1;
    }
    assert(value == 0);

    let refValue = ref 10;
    while refValue > 0 {
        refValue := refValue - 1;
    }
    assert(refValue == 0);

    let boolValue = true;
    let boolCounter = 0;
    while boolValue {
        boolValue = !boolValue;
        boolCounter = boolCounter + 1;
    }
    assert(boolCounter == 1);

    let counter = 10;
    let nestedCounter = 10;
    let numIterations = 0;
    while counter > 0 {
        while nestedCounter > 0 {
            numIterations = numIterations + 1;
            nestedCounter = nestedCounter - 1;
        }
        counter = counter - 1;
        nestedCounter = 10;
    }
    assert(numIterations == 100);

    let otherCounter = 10;
    let otherNestedCounter = 10;
    let otherDoubleNestedCounter = 10;
    let otherNumIterations = 0;
    while otherCounter > 0 {
        while otherNestedCounter > 0 {
            while otherDoubleNestedCounter > 0 {
                otherNumIterations = otherNumIterations + 1;
                otherDoubleNestedCounter = otherDoubleNestedCounter - 1;
            }
            otherNestedCounter = otherNestedCounter - 1;
            otherDoubleNestedCounter = 10;
        }
        otherCounter = otherCounter - 1;
        otherNestedCounter = 10;
    }
    assert(otherNumIterations == 1000);

    let ifWhileCounter = 20;
    let evenCounter = 0;
    let oddCounter = 0;
    while ifWhileCounter > 0 {
        if ifWhileCounter mod 2 == 0 {
            evenCounter = evenCounter + 1;
        } else {
            oddCounter = oddCounter + 1;
        }
        ifWhileCounter = ifWhileCounter - 1;
    }
    assert(evenCounter == 10);
    assert(oddCounter == 10);

    const whileStruct = { a: 0, b: 10 };
    while whileStruct.a < whileStruct.b {
        whileStruct.a = whileStruct.a + 1;
    }
    assert(whileStruct.a == whileStruct.b);

    const whileTuple = { 0, 10 };
    while whileTuple.0 < whileTuple.1 {
        whileTuple.0 = whileTuple.0 + 1;
    }
    assert(whileTuple.0 == whileTuple.1);

    if whileTuple.0 == whileTuple.1 {
        whileTuple.0 = 0;
        while whileTuple.0 < whileTuple.1 {
            whileTuple.0 = whileTuple.0 + 1;
        }
        assert(whileTuple.0 == whileTuple.1);
    }

    const whileArray = [0, 10];
    while whileArray[0] <= whileArray[1] {
        whileArray[0] = whileArray[0] + 1;
    }
    assert(whileArray[0] - 1 == whileArray[1]);

    whileArray[0] = 20;
    while whileArray[0] >= whileArray[1] {
        whileArray[0] = whileArray[0] - 1;
    }
    assert(whileArray[0] + 1 == whileArray[1]);

    const myClass = new SimpleClass(0);
    const otherClass = new SimpleClass(10);
    while myClass.getValue() < otherClass.getValue() {
        myClass.incrementValue();
    }
    assert(myClass.getValue() == otherClass.getValue());
}
testWhileLoops();

proc testWhileReturns() {
    let x = 80;
    while x > 65 {
        if x == 75 {
            print("returning early!");
            return;
        }
        x = x - 1;
    }
}
testWhileReturns();

proc testForLoopReturns(x: int) {
    print("testing for loop returns");
    for i in range(1, 10) {
        print("loop", i);
        if i mod x == 0 {
            print("returning early", x, i);
            return;
        }
        print("printing late");
        return;
    }
    print("didn't return early", x);
}
testForLoopReturns(100);
testForLoopReturns(5);

proc testNestedForLoops() {
    const a = [1,2,3]
    let numIterations = 0;
    for i in range(10) {
        const b = [4,5,6];
        for j in range(10) {
            const c = [7,8,9];
            numIterations = numIterations + 1;
        }
        const d = [10,11,12];
    }
    assert(numIterations == 100);
};
testNestedForLoops();

proc testForLoops() {
    let value = 10;
    for i in range(value) {
        value = value - 1;
    }
    assert(value == 0);

    let refValue = ref 10;
    for i in range(dref refValue) {
        refValue := refValue - 1;
    }
    assert(refValue == 0);

    let numIterations = 0;
    for i in range(10) {
        for j in range(10) {
            numIterations = numIterations + 1;
        }
    }
    assert(numIterations == 100);

    let otherNumIterations = 0;
    for i in range(10) {
        for j in range(10) {
            for k in range(10) {
                otherNumIterations = otherNumIterations + 1;
            }
        }
    }
    assert(otherNumIterations == 1000);

    let ifWhileCounter = 20;
    let evenCounter = 0;
    let oddCounter = 0;
    for i in range(20) {
        if i mod 2 == 0 {
            evenCounter = evenCounter + 1;
        } else {
            oddCounter = oddCounter + 1;
        }
    }
    assert(evenCounter == 10);
    assert(oddCounter == 10);

    let sumTotal = 0;
    for i in [0,1,5,2,5] {
        sumTotal = sumTotal + i;
    }
    assert(sumTotal == 13);

    const myStructValues = [
        { a: 100, b: 10, c: 1 },
        { a: 200, b: 20, c: 2 },
        { a: 400, b: 40, c: 4 }
    ];
    let myStructValueTotal = 0;
    for structValue in myStructValues {
        myStructValueTotal = myStructValueTotal + structValue.a + structValue.b + structValue.c;
    }
    assert(myStructValueTotal == 777);

    const refMyArray = ref [1,2,3,4,5,6];
    let refMyArrayTotal = 0;
    for i in dref refMyArray {
        refMyArrayTotal = refMyArrayTotal + i;
    }
    assert(refMyArrayTotal == 21);

    const refMyStructWithArray = ref { foo: [1,2,3,4,5,6,8] };
    let refMyStructWithArrayTotal = 0;
    for i in refMyStructWithArray.foo {
        refMyStructWithArrayTotal = refMyStructWithArrayTotal + i;
    }
    assert(refMyStructWithArrayTotal == 29);

    const refMyTupleWithArray = ref { [1,2,3,4,5,6,8,9,10] };
    let refMyTupleWithArrayTotal = 0;
    for i in refMyTupleWithArray.0 {
        refMyTupleWithArrayTotal = refMyTupleWithArrayTotal + i;
    }
    assert(refMyTupleWithArrayTotal == 48);

    let refDrefArrayTotal = 0;
    for i in dref ref [1,3,5,7,9] {
        refDrefArrayTotal = refDrefArrayTotal + i;
    }
    assert(refDrefArrayTotal == 25);

    const myLambdaArray = () => [20,30,40,50];
    let myLambdaArrayTotal = 0;
    for i in myLambdaArray() {
        myLambdaArrayTotal = myLambdaArrayTotal + i;
    }
    assert(myLambdaArrayTotal == 140);

    let myGetArrayTotal = 0;
    for i in getArray([109,209,309]) {
        myGetArrayTotal = myGetArrayTotal + i;
    }
    assert(myGetArrayTotal == 627);

    let myGetRefArrayTotal = 0;
    for i in dref getRefArray([109,209,309,409]) {
        myGetRefArrayTotal = myGetRefArrayTotal + i;
    }
    assert(myGetRefArrayTotal == 1036);

    const myLambdaRefArray = () => ref [20,30,40,50,60];
    let myLambdaRefArrayTotal = 0;
    for i in dref myLambdaRefArray() {
        myLambdaRefArrayTotal = myLambdaRefArrayTotal + i;
    }
    assert(myLambdaRefArrayTotal == 200);

    const modifiedArray = [1,2,3,4,5];
    const modifiedArrayTotal = 0;
    for i in modifiedArray {
        modifiedArrayTotal = modifiedArrayTotal + i;
        modifiedArray.dropLast(1);
    }
    assert(modifiedArray == [1,2]);
    assert(modifiedArrayTotal == 6);

    const modifiedRefArray = ref [1,2,3,4,5];
    const modifiedRefArrayTotal = 0;
    for i in modifiedRefArray {
        modifiedRefArrayTotal = modifiedRefArrayTotal + i;
        modifiedRefArray.dropLast(4);
    }
    assert(modifiedRefArray == [1]);
    assert(modifiedRefArrayTotal == 1);

    const modifiedArrayEmptyResult = [1,2,3,4,5];
    const modifiedArrayEmptyResultTotal = 0;
    for i in modifiedArrayEmptyResult {
        modifiedArrayEmptyResultTotal = modifiedArrayEmptyResultTotal + i;
        modifiedArrayEmptyResult.dropLast(4);
    }
    assert(modifiedArrayEmptyResult == [1]);
    assert(modifiedArrayEmptyResultTotal == 1);

    const modifiedArrayWithRef = [1,2,3,4,5];
    const modifiedArrayWithRefTotal = 0;
    for i in ref modifiedArrayWithRef {
        modifiedArrayWithRefTotal = modifiedArrayWithRefTotal + i;
    }
    assert(modifiedArrayWithRefTotal == 15);
}
testForLoops();

proc testTuples() {
    const baseString = "my ";
    const myTuple = { 1, 1.15, 'c', true, "hi", [9, 6, 3], { a: 1, b: false, c: "foobar" }, { false, 19, 29 }, () => "tuple-lambda", () => baseString ++ "other-tuple-lambda" };
    const tupleLambda = (x: { bool, int, char }) => x.1 + myTuple.0;
    const myTupleString = myTuple.8();
    assert(myTupleString == "tuple-lambda");
    const myOtherTupleString = myTuple.9();
    assert(myOtherTupleString == "my other-tuple-lambda");

    let total = 0;
    for i in myTuple.5 {
        total = total + i;
    }
    assert(total == 18);
}
testTuples();

proc testClass() {
    const mySimpleClass = new SimpleClass(100);
    const staticResult = 200 + SimpleClass.staticValue;
    assert(staticResult == 300);

    SimpleClass.staticValue = 150;
    assert(SimpleClass.staticValue == 150);

    const myComplexClass = new ComplexClass(18);
    assert(myComplexClass.getAge() == 18);
    assert(myComplexClass.getName() == "Joe");
    assert(myComplexClass.getHairColor() == "Black");
    assert(myComplexClass.age == 18);
    assert(myComplexClass.name == "Joe");
    assert(myComplexClass.hairColor == "Black");

    const myOtherComplexClass = new ComplexClass(28, "Roger", "Brown");
    assert(myOtherComplexClass.getAge() == 28);
    assert(myOtherComplexClass.getName() == "Roger");
    assert(myOtherComplexClass.getHairColor() == "Brown");
    assert(myOtherComplexClass.age == 28);
    assert(myOtherComplexClass.name == "Roger");
    assert(myOtherComplexClass.hairColor == "Brown");

    const myStaticComplexClass = ComplexClass.create();
    assert(myStaticComplexClass.getAge() == 2);
    assert(myStaticComplexClass.getName() == "Joe");
    assert(myStaticComplexClass.getHairColor() == "Black");
    assert(myStaticComplexClass.age == 2);
    assert(myStaticComplexClass.name == "Joe");
    assert(myStaticComplexClass.hairColor == "Black");

}
testClass();

func functionUsedAsLambda(x: int): int {
    return x + 1000;
}

func functionUsedAsLambda(x: string): int {
    return x.size();
}

proc testFunctionsAsLambdas() {
    const lambdaUsingFunction = (x: int, l: (int) => int) {
        return l(x) + 1000;
    };
    assert(lambdaUsingFunction(1, functionUsedAsLambda) == 2001);

    const lambdaUsingOtherFunction = (x: string) {
        return functionUsedAsLambda(x) + 90;
    };
    const result = lambdaUsingOtherFunction("hello world");
    assert(lambdaUsingOtherFunction("hello world") == 101);
}
testFunctionsAsLambdas();

proc procUsedAsLambda(x: ref<int>) {
    x := x + 1;
}

proc procUsedAsLambda(x: ref<int>, y: ref<int>) {
    x := x + 1 + y;
}

proc testProceduresAsLambdas() {
    const lambdaUsingProcedure = (x: ref<int>, l: (ref<int>) => void) {
        x := x + 10;
        l(x);
    };

    const x = ref 1;
    lambdaUsingProcedure(x, procUsedAsLambda);
    assert(x == 12);
    procUsedAsLambda(x, ref 20);
    assert(x == 33);
}
testProceduresAsLambdas();

proc testStringPrototype() {
    let myString = "hello-world";
    myString.drop(1);
    assert(myString == "ello-world");
    myString.dropLast(2);
    assert(myString == "ello-wor");
    myString.dropLast(100);
    assert(myString == "");
    myString = "hello-world";
    myString.drop(100);
    print("MY STRING", myString);
    assert(myString == "");
    assert(myString.empty());
    assert(myString.size() == 0);

    // will support head and last once we add null support
    //assert(myString.head() == '\0');
    //assert(myString.last() == '\0');

    assert(myString.tail() == "");
    assert(myString.take(5) == "");
    assert(myString.takeLast(5) == "");
    assert(myString.take(0) == "");
    assert(myString.takeLast(0) == "");
    myString.prepend('m');
    assert(myString == "m");
    myString.append('q');
    assert(myString == "mq");
    myString.drop(2);
    assert(myString == "");
    myString.append('r');
    assert(myString == "r");

    const otherString = "my-other-string";
    assert(!otherString.empty());
    assert(otherString.size() == 15);

    // will support head and last once we add null support
    //assert(otherString.head() == 'm');
    //assert(otherString.last() == 'g');

    assert(otherString.at(0) == 'm');
    assert(otherString.at(1) == 'y');
    assert(otherString.at(14) == 'g');
    assert(otherString.tail() == "y-other-string");
    assert(otherString.take(5) == "my-ot");
    assert(otherString.takeLast(5) == "tring");
    assert(otherString.take(0) == "");
    assert(otherString.takeLast(0) == "");

    const shortString = "aq";
    assert(shortString.tail() == "q");
    assert(shortString.take(100) == "aq");
    assert(shortString.takeLast(100) == "aq");
    assert(shortString.take(0) == "");
    assert(shortString.takeLast(0) == "");
    shortString.prepend('m');
    assert(shortString == "maq");
    shortString.append('q');
    assert(shortString == "maqq");
}
testStringPrototype();

