import MyOtherModule from "./other-test-file.jet";
import MySecondModule from "./second-test-file.jet";
import MyThirdModule from "./third-test-file.jet";
import MyFourthModule from "./fourth-test-file.jet";
import BigModule from "./big-module.jet";

// Global Malloc Count: 185 (malloc 2257, free 2073)
// we need to factor in global variable assignment (deduct from global malloc count)

// syntax not supported but workaround exists for the following scenarios:
// #1 lambda-with-fat-arrow expression as left operand of binary expression
// not supported: () => true == () => true
// workaround: (() => true) == () => true

// interfaces will not be supported on release
// interface MyInterface {
//     getValue: () => int
// }

class SimpleClass {
    public static staticValue: int = 100;
    public value: int;

    constructor(value: int) {
        this.value = value;
    }

    public getValue(): int {
        return this.value;
    }

    public incrementValue() {
        this.value = this.value + 1;
    }
}

class ComplexClass {
    public age: int;
    public name: string;
    public hairColor: string;

    constructor(age: int, name: string, hairColor: string) {
        this.age = age;
        this.name = name;
        this.hairColor = hairColor;
    }

    constructor(age: int) {
        this.age = age;
        this.name = "Joe";
        this.hairColor = "Black";
    }

    public getAge(): int {
        return this.age;
    }

    public getName(): string {
        return this.name;
    }

    public getHairColor(): string {
        return this.hairColor;
    }

    public static create(): ComplexClass {
        return new ComplexClass(2);
    }
}

