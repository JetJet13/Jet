    assert(MyOtherModule::myOtherGlobalLambda(2) == -1);
    assert(MyFourthModule::myFourthIntFunction(MyFourthModule::MyFourthGlobalInt) == 7799);
}
testModules();

func ifStatements(x: int, y: int, z: int): int {
    if x > 1 {
        if y > 10 {
            if z > 100 {
                return 99;
            }
            return 88;
        }
        return 77;
    }
    return 66;
}

func otherIfStatements(x: int, y: int, z: int): int {
    const a = [1,2,3,4];
    if x > y {
        const b = [1,2,3,4];
        if x == 10 {
            const c = [1,2,3,4];
            return 10;
        } else {
            const d = [1,2,3,4];
            if y > 0 {
                const e = [1,2,3,4];
                return 9;
            }
            const f = [1,2,3,4];
            return 8;
        }
        const g = [1,2,3,4];
    } else if x == y {
        const h = [1,2,3,4];
        if z == 0 {
            const i = [1,2,3,4];
            return 7;
        }
        const j = [1,2,3,4];
        return 6;
    } else {
        const k = [1,2,3,4];
        if z > 100 {
            const l = [1,2,3,4];
            return 5;
        }
        const m = [1,2,3,4];
        return 4;
    }
    const n = [1,2,3,4];
}

proc testIfStatements() {
    assert(ifStatements(5, 15, 115) == 99);
    assert(ifStatements(5, 15, 98) == 88);
    assert(ifStatements(5, 9, 98) == 77);
    assert(ifStatements(0, 9, 115) == 66);
    assert(otherIfStatements(10, -15, 0) == 10);
    assert(otherIfStatements(9, 5, 0) == 9);
    assert(otherIfStatements(9, -9, 0) == 8);
    assert(otherIfStatements(9, 9, 0) == 7);
    assert(otherIfStatements(9, 9, 1) == 6);
    assert(otherIfStatements(5, 15, 105) == 5);
    assert(otherIfStatements(5, 15, 97) == 4);
}
testIfStatements();

proc testEnums() {
    const myEnumValue = SimpleEnum.Alpha;
    assert(myEnumValue == SimpleEnum.Alpha);

    const myStringEnumValue = StringEnum.Alpha;
    assert(myStringEnumValue == StringEnum.Alpha);

    const myEnumStruct = { foo: SimpleEnum.Alpha, bar: StringEnum.Alpha };
    const myEnumTuple = { SimpleEnum.Alpha, StringEnum.Alpha };
    const myEnumArray = [ SimpleEnum.Alpha ];
    const myStringEnumArray = [ StringEnum.Alpha ];

    const enumArrowLambda = (x: SimpleEnum) => x;
    const enumBlockLambda = (x: SimpleEnum) { return x; };
    assert(enumArrowLambda(SimpleEnum.Alpha) == SimpleEnum.Alpha);
    assert(enumBlockLambda(SimpleEnum.Alpha) == SimpleEnum.Alpha);
    assert(enumArrowLambda(myEnumValue) == SimpleEnum.Alpha);
    assert(enumBlockLambda(myEnumValue) == SimpleEnum.Alpha);
    assert(enumArrowLambda(myEnumStruct.foo) == SimpleEnum.Alpha);
    assert(enumBlockLambda(myEnumStruct.foo) == SimpleEnum.Alpha);
    assert(enumArrowLambda(myEnumTuple.0) == SimpleEnum.Alpha);
    assert(enumBlockLambda(myEnumTuple.0) == SimpleEnum.Alpha);
    assert(enumArrowLambda(myEnumArray[0]) == SimpleEnum.Alpha);
    assert(enumBlockLambda(myEnumArray[0]) == SimpleEnum.Alpha);

    const stringEnumArrowLambda = (x: StringEnum) => x;
    const stringEnumBlockLambda = (x: StringEnum) { return x; };
    assert(stringEnumArrowLambda(StringEnum.Alpha) == StringEnum.Alpha);
    assert(stringEnumBlockLambda(StringEnum.Alpha) == StringEnum.Alpha);
    assert(stringEnumArrowLambda(myStringEnumValue) == StringEnum.Alpha);
    assert(stringEnumBlockLambda(myStringEnumValue) == StringEnum.Alpha);
    assert(stringEnumArrowLambda(myEnumStruct.bar) == StringEnum.Alpha);
    assert(stringEnumBlockLambda(myEnumStruct.bar) == StringEnum.Alpha);
    assert(stringEnumArrowLambda(myEnumTuple.1) == StringEnum.Alpha);
    assert(stringEnumBlockLambda(myEnumTuple.1) == StringEnum.Alpha);
    assert(stringEnumArrowLambda(myStringEnumArray[0]) == StringEnum.Alpha);
    assert(stringEnumBlockLambda(myStringEnumArray[0]) == StringEnum.Alpha);

    let tempEnumValue = SimpleEnum.Alpha;
    tempEnumValue = SimpleEnum.Beta;
    assert(tempEnumValue == SimpleEnum.Beta);

    let tempStringEnumValue = StringEnum.Alpha;
    tempStringEnumValue = StringEnum.Beta;
    assert(tempStringEnumValue == StringEnum.Beta);
}
testEnums();

func factorial(x: int): int {
    if x == 0 {
        return 1;
    }
    return x * factorial(x - 1);
}
assert(factorial(3) == 6);
assert(factorial(4) == 24);
assert(factorial(10) == 3628800);

func isPrime(x: int): bool {
    if x == 1 || x == 0 {
        return false;
    }
    for i in range(2, x) {
        if x mod i == 0 {
            return false;
        }
    }
    return true;
}
assert(isPrime(0) == false);
assert(isPrime(1) == false);
assert(isPrime(2) == true);
assert(isPrime(3) == true);
assert(isPrime(4) == false);
assert(isPrime(5) == true);

