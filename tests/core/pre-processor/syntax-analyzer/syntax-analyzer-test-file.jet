// time for classes
class MyClass {
    public myIntOne: int; // 4
    public myIntTwo: int = 5; // 6
    public myIntThree = 5; // 4

    public const myIntOne: int; // 5
    public const myIntTwo: int = 5; // 7
    public const myIntThree = 5; // 5

    protected static fooOne: int; // 5
    protected static fooTwo: int = 10; // 7
    protected static fooThree = 10; // 5

    private static const mickOne: bool; // 6
    private static const mickTwo: bool = true; // 8
    private static const mickThree = true; // 6

    constructor() {
        this.initIteratorTrait(500);
        this.foo = 10;
        this.bar = true;
    }

    constructor(foo: int) {
            this.foo = foo;
            this.bar = true;
            this.initIteratorTrait(this.foo);
    }

    public static create(foo: int) MyClass {
        return new MyClass(foo);
    }

    protected static doSomething() MyClass {
        return new MyClass();
    }

    private static doSomethingElse() MyClass {
        return new MyClass(100);
    }

    public isValid() bool {
        return this.bar;
    }

    protected setBar(bar: bool) this {
        this.bar = bar;
        return this;
    }

    private hello() string {
        return "hello world!";
    }

    private hello() {
        this.bar = true;
    }

}

