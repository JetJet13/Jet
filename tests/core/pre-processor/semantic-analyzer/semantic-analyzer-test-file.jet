class MyClass {
    public myIntOne: int;
    public myIntTwo: int = 5;
    public myIntThree = 5;

    public const myIntOneConst: int;
    public const myIntTwoConst: int = 5;
    public const myIntThreeConst = 5;

    private static const mickOneStatic: bool;
    private static const mickTwoStatic: bool = true;
    private static const mickThreeStatic = true;


    private foo: int;
    private bar: bool;

    constructor() {
        this.foo = 10;
        this.bar = true;
    }

    constructor(foo: int) {
            this.foo = foo;
            this.bar = true;
    }

    public static create(foo: int): MyClass {
        return new MyClass(foo);
    }

    private static doSomethingElse(): MyClass {
        return new MyClass(100);
    }

    private static getBar(): bool {
        return true;
    }

    public isValid(): () -> bool {
        return MyClass.getBar;
    }

    private hello(): string {
        return "hello world!";
    }

    private helloBar() {
        this.bar = true;
    }

}

func hi(n: int): int {
    if n == 0 {
        return 0;
    }

    if n == 1 {
        return 10;
    } else {
      if n == 2 {
        if n == 3 {
          return 40;
        } else {
           return 11;
        }
      } else {
        return 500;
      }
    }
}

func bye(): int {
