class OtherClass {
    public myIntOne: MyClass;
}

class MyClass {
    public myIntOne: int;
    public myIntTwo: int = 5;
    public myIntThree = 5;

    public const myIntOneConst: int;
    public const myIntTwoConst: int = 5;
    public const myIntThreeConst = 5;

    protected static fooOneStatic: int;
    protected static fooTwoStatic: int = 10;
    protected static fooThreeStatic = 10;

    private static const mickOneStatic: boolean;
    private static const mickTwoStatic: boolean = true;
    private static const mickThreeStatic = true;

    private initMyClass = new MyClass(5);
    private myClassProp: MyClass;
    private otherClass: OtherClass = new OtherClass();

    private foo: int;
    private bar: boolean;

    constructor(other: MyClass) {
        this.foo = 10;
        this.bar = true;
    }

    constructor(foo: int) {
            this.foo = foo;
            this.bar = true;
    }

    public static create(foo: int) MyClass {
        return new MyClass(foo);
    }

    protected static doSomething(other: MyClass) MyClass {
        return new MyClass(40);
    }

    private static doSomethingElse() MyClass {
        return new MyClass(100);
    }

    private static getBar() boolean {
        return true;
    }

    public isValid() func<> => boolean {
        return this.getBar;
    }

    protected setBar(bar: boolean) this {
        this.bar = bar;
        return this;
    }

    private hello() string {
        return "hello world!";
    }

    private helloBar() {
        this.bar = true;
    }

}

func hi(n: int) int {
    if n == 0 {
        return 0;
    }

    if n == 1 {
        return 10;
    } else {
      if n == 2 {
        if n == 3 {
          return 40;
        } else {
           return 11;
        }
      } else {
        return 500;
      }
    }
}

func bye() int {
    try {
        if 5 == 5 {
            return 5;
        }
        return 1;
    } catch err {
        return 0;
    }
}

func withFinally() int {
    try {
        const zoo = 10;
    } catch err {
        const moo = 5;
    } finally {
        return 10;
    }
}

