define internal ptr @jet.copy.value(ptr %0, ptr %1, %TypeValueType %2) {
  %valueTypeSizeInBytes = extractvalue %TypeValueType %2, 1
  %valueTypeId = extractvalue %TypeValueType %2, 0
  br label %literal.if.cond

literal.if.cond:                                  ; preds = %3
  %4 = icmp slt i64 %valueTypeId, 5
  br i1 %4, label %literal.if.true, label %pointer.if.cond

literal.if.true:                                  ; preds = %literal.if.cond
  %5 = call ptr @jet.memcpy(ptr %0, ptr %1, i64 %valueTypeSizeInBytes)
  br label %if.end

pointer.if.cond:                                  ; preds = %literal.if.cond
  %6 = icmp eq i64 %valueTypeId, 1000
  br i1 %6, label %pointer.if.true, label %ref.if.cond

pointer.if.true:                                  ; preds = %pointer.if.cond
  %7 = call ptr @jet.copy.pointer(ptr %0, ptr %1, %TypeValueType %2)
  br label %if.end

ref.if.cond:                                      ; preds = %pointer.if.cond
  %8 = icmp eq i64 %valueTypeId, 1001
  br i1 %8, label %ref.if.true, label %struct.ref.if.cond

ref.if.true:                                      ; preds = %ref.if.cond
  %9 = call ptr @jet.copy.shared.ptr(ptr %0, ptr %1, %TypeValueType %2)
  br label %if.end

struct.ref.if.cond:                               ; preds = %ref.if.cond
  %10 = icmp eq i64 %valueTypeId, 2001
  br i1 %10, label %struct.ref.if.true, label %struct.if.cond

struct.ref.if.true:                               ; preds = %struct.ref.if.cond
  %11 = call ptr @jet.copy.struct.ref(ptr %0, ptr %1, %TypeValueType %2)
  br label %if.end

struct.if.cond:                                   ; preds = %struct.ref.if.cond
  %12 = icmp eq i64 %valueTypeId, 2000
  br i1 %12, label %struct.if.true, label %lambda.if.cond

struct.if.true:                                   ; preds = %struct.if.cond
  %13 = call ptr @jet.copy.struct(ptr %0, ptr %1, %TypeValueType %2)
  br label %if.end

lambda.if.cond:                                   ; preds = %struct.if.cond
  %14 = icmp eq i64 %valueTypeId, 4000
  br i1 %14, label %lambda.if.true, label %array.if.true

lambda.if.true:                                   ; preds = %lambda.if.cond
  %15 = call ptr @jet.copy.lambda(ptr %0, ptr %1, %TypeValueType %2)
  br label %if.end

array.if.true:                                    ; preds = %lambda.if.cond
  %16 = call ptr @jet.copy.array(ptr %0, ptr %1, %TypeValueType %2)
  br label %if.end

if.end:                                           ; preds = %array.if.true, %lambda.if.true, %struct.if.true, %struct.ref.if.true, %ref.if.true, %pointer.if.true, %literal.if.true
  ret ptr %0
}

define internal ptr @jet.copy.array(ptr %0, ptr %1, %TypeValueType %2) {
  %4 = getelementptr inbounds %ArrayPointer, ptr %1, i32 0, i32 0
  %5 = load i64, ptr %4, align 4
  %6 = getelementptr inbounds %ArrayPointer, ptr %1, i32 0, i32 1
  %7 = load i64, ptr %6, align 4
  %8 = alloca %ArrayPointer, align 8
  %9 = getelementptr inbounds %ArrayPointer, ptr %8, i32 0, i32 0
  store i64 %5, ptr %9, align 4
  %10 = getelementptr inbounds %ArrayPointer, ptr %8, i32 0, i32 1
  store i64 %7, ptr %10, align 4
  %11 = getelementptr inbounds %ArrayPointer, ptr %8, i32 0, i32 2
  %elementTypeValue = extractvalue %TypeValueType %2, 3
  %12 = load %TypeValueType, ptr %elementTypeValue, align 8
  %elementTypeSizeInBytes = extractvalue %TypeValueType %12, 1
  %13 = extractvalue %TypeValueType %12, 0
  %14 = call i64 @jet.malloc.size(i64 %5, i64 %elementTypeSizeInBytes)
  %15 = call ptr @jet.malloc(i64 %5, i64 %elementTypeSizeInBytes)
  store ptr %15, ptr %11, align 8
  %16 = icmp eq i64 %7, 1
  br i1 %16, label %depth.1.if.true, label %depth.n.prep

depth.1.if.true:                                  ; preds = %3
  %17 = getelementptr inbounds %ArrayPointer, ptr %1, i32 0, i32 2
  %18 = load ptr, ptr %17, align 8
  %19 = icmp slt i64 %13, 500
  br i1 %19, label %depth.1.is.literal.if.true, label %depth.1.is.literal.if.false

depth.1.is.literal.if.true:                       ; preds = %depth.1.if.true
  %20 = call ptr @jet.memcpy(ptr %15, ptr %18, i64 %14)
  br label %depth.1.if.end

depth.1.is.literal.if.false:                      ; preds = %depth.1.if.true
  %elementByteOffset = alloca i64, align 8
  store i64 0, ptr %elementByteOffset, align 4
  %depthOneForLoopIndex = alloca i64, align 8
  store i64 0, ptr %depthOneForLoopIndex, align 4
  br label %depth.1.for.loop.condition

depth.1.for.loop.condition:                       ; preds = %depth.1.for.loop.body, %depth.1.is.literal.if.false
  %21 = load i64, ptr %depthOneForLoopIndex, align 4
  %22 = icmp slt i64 %21, %5
  br i1 %22, label %depth.1.for.loop.body, label %depth.1.for.loop.end

depth.1.for.loop.body:                            ; preds = %depth.1.for.loop.condition
  %23 = load i64, ptr %elementByteOffset, align 4
  %24 = getelementptr inbounds i8, ptr %15, i64 %23
  %25 = getelementptr inbounds i8, ptr %18, i64 %23
  %26 = call ptr @jet.copy.value(ptr %24, ptr %25, %TypeValueType %12)
  %27 = add i64 %23, %elementTypeSizeInBytes
  store i64 %27, ptr %elementByteOffset, align 4
  %28 = add i64 %21, 1
  store i64 %28, ptr %depthOneForLoopIndex, align 4
  br label %depth.1.for.loop.condition

depth.1.for.loop.end:                             ; preds = %depth.1.for.loop.condition
  br label %depth.1.if.end

depth.1.if.end:                                   ; preds = %depth.1.for.loop.end, %depth.1.is.literal.if.true
  %29 = load %ArrayPointer, ptr %8, align 8
  store %ArrayPointer %29, ptr %0, align 8
  ret void

depth.n.prep:                                     ; preds = %3
  %forLoopIndex = alloca i64, align 8
  %30 = getelementptr inbounds %ArrayPointer, ptr %1, i32 0, i32 2
  %31 = load ptr, ptr %30, align 8
  store i64 0, ptr %forLoopIndex, align 4
  br label %depth.n.for.loop.condition

depth.n.for.loop.condition:                       ; preds = %depth.n.for.loop.body, %depth.n.prep
  %32 = load i64, ptr %forLoopIndex, align 4
  %33 = icmp slt i64 %32, %5
  br i1 %33, label %depth.n.for.loop.body, label %depth.n.for.loop.end

depth.n.for.loop.body:                            ; preds = %depth.n.for.loop.condition
  %34 = getelementptr inbounds %ArrayPointer, ptr %31, i64 %32
  %35 = getelementptr inbounds %ArrayPointer, ptr %15, i64 %32
  %36 = call ptr @jet.copy.array(ptr %35, ptr %34, %TypeValueType %12)
  %37 = add i64 %32, 1
  store i64 %37, ptr %forLoopIndex, align 4
  br label %depth.n.for.loop.condition

depth.n.for.loop.end:                             ; preds = %depth.n.for.loop.condition
  %38 = load %ArrayPointer, ptr %8, align 8
  store %ArrayPointer %38, ptr %0, align 8
  ret void
}

define internal ptr @jet.copy.pointer(ptr %0, ptr %1, %TypeValueType %2) {
  %4 = extractvalue %TypeValueType %2, 3
  %5 = getelementptr inbounds %TypeValueType, ptr %4, i64 0, i64 1
  %6 = load i64, ptr %5, align 4
  %7 = call ptr @jet.malloc(i64 1, i64 %6)
  %8 = load %TypeValueType, ptr %4, align 8
  %9 = load ptr, ptr %1, align 8
  %10 = call ptr @jet.copy.value(ptr %7, ptr %9, %TypeValueType %8)
  store ptr %7, ptr %0, align 8
  ret void
}

define internal ptr @jet.copy.lambda(ptr %0, ptr %1, %TypeValueType %2) {
  %4 = getelementptr inbounds %Invocable, ptr %0, i32 0, i32 0
  %5 = getelementptr inbounds %Invocable, ptr %1, i32 0, i32 0
  %6 = load ptr, ptr %5, align 8
  store ptr %6, ptr %4, align 8
  %7 = getelementptr inbounds %Invocable, ptr %0, i32 0, i32 1
  %8 = getelementptr inbounds %Invocable, ptr %1, i32 0, i32 1
  %9 = load ptr, ptr %8, align 8
  store ptr %9, ptr %7, align 8
  %10 = getelementptr inbounds %Invocable, ptr %0, i32 0, i32 2
  %11 = getelementptr inbounds %Invocable, ptr %1, i32 0, i32 2
  %12 = load ptr, ptr %11, align 8
  store ptr %12, ptr %10, align 8
  %13 = getelementptr inbounds %Invocable, ptr %0, i32 0, i32 3
  %14 = getelementptr inbounds %Invocable, ptr %1, i32 0, i32 3
  %15 = load ptr, ptr %14, align 8
  store ptr %15, ptr %13, align 8
  %16 = getelementptr inbounds %Invocable, ptr %0, i32 0, i32 4
  %17 = getelementptr inbounds %Invocable, ptr %1, i32 0, i32 4
  %18 = load i1, ptr %17, align 1
  store i1 %18, ptr %16, align 1
  %19 = load i64, ptr %12, align 4
  %20 = add i64 %19, 1
  store i64 %20, ptr %12, align 4
  ret void
}

define internal ptr @jet.copy.struct(ptr %0, ptr %1, %TypeValueType %2) {
  %4 = extractvalue %TypeValueType %2, 2
  %elementByteOffset = alloca i64, align 8
  store i64 0, ptr %elementByteOffset, align 4
  %forLoopIndex = alloca i64, align 8
  %typeValueAlloc = extractvalue %TypeValueType %2, 3
  store i64 0, ptr %forLoopIndex, align 4
  br label %for.loop.condition

for.loop.condition:                               ; preds = %for.loop.body, %3
  %5 = load i64, ptr %elementByteOffset, align 4
  %6 = load i64, ptr %forLoopIndex, align 4
  %7 = getelementptr inbounds ptr, ptr %typeValueAlloc, i64 %6
  %8 = load ptr, ptr %7, align 8
  %9 = load %TypeValueType, ptr %8, align 8
  %10 = icmp slt i64 %6, %4
  br i1 %10, label %for.loop.body, label %for.loop.end

for.loop.body:                                    ; preds = %for.loop.condition
  %11 = getelementptr inbounds i8, ptr %0, i64 %5
  %12 = getelementptr inbounds i8, ptr %1, i64 %5
  %13 = call ptr @jet.copy.value(ptr %11, ptr %12, %TypeValueType %9)
