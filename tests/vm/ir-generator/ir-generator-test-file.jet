    const b = "John Smith";
    const refB = ref b;

    const s = { a: true, nest: { b: 100, c: false, d: [8, 9] }, r: ref 90, ra: ref [10, 20], rs: ref { foo: 'q', bar: true } };
    const refS = ref s;
    const copyS = s;
