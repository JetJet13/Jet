// if a block returns, clean all variables in-scope and outer scope
// otherwise, clean all variables in-scope

func testCleanup() int {
    const x = [1, 2, 4];
    const y = 5;
    const refY = ref y;
    if y > 10 {
        const z = "hello";
        const m = "world";
        // clean z, m
    } else if y == 10 {
        const b = "mike";
        const k = "dark";
        if y > 10 {
            const p = "loopy";
            const q = "root";
            // clean p, q
        } else {
            const t = "bike";
            const e = "soup";
            // clean t, e
        }
        // clean x, y, refY, b, k
        return 0;
    }
    // clean x, y, refY
    return 5;
}